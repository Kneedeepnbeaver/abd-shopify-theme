    </svg>
  {% when 'heart-filled' %}
    <svg class="icon icon--{{ size }} {{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"{% if aria_label != blank %} aria-label="{{ aria_label }}"{% endif %}>
      <path d="M17.5 3.5C16.5 2.5 15 2 13.5 2C12 2 10.5 2.5 9.5 3.5L10 4L10.5 3.5C11.5 2.5 13 2 14.5 2C16 2 17.5 2.5 18.5 3.5C20.5 5.5 20.5 8.5 18.5 10.5L10 19L1.5 10.5C-0.5 8.5 -0.5 5.5 1.5 3.5C2.5 2.5 4 2 5.5 2C7 2 8.5 2.5 9.5 3.5L10 4L10.5 3.5C11.5 2.5 13 2 14.5 2C16 2 17.5 2.5 18.5 3.5Z" fill="currentColor"/>

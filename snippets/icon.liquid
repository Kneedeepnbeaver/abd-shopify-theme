{% comment %}
  Icon Component
  
  This snippet renders SVG icons that can be used throughout the theme.
  It provides a library of common e-commerce icons like cart, heart, search,
  user, menu, arrows, and more. Icons are SVG-based for performance and can
  be customized by size and color. All icons include proper accessibility
  attributes for screen readers.
  
  Renders an SVG icon with customizable size and color.
  
  @param {string} icon - Icon name (required): cart, heart, search, user, menu, close, arrow-left, arrow-right, arrow-up, arrow-down, plus, minus, check, star, star-empty, filter, sort, share, play, pause, chevron-left, chevron-right, chevron-up, chevron-down
  @param {string} size - Icon size: small, medium, large (default: medium)
  @param {string} class - Additional CSS classes
  @param {string} aria_label - Accessibility label (optional, defaults to icon name)
  
  @example
  {% render 'icon', icon: 'cart', size: 'large' %}
  {% render 'icon', icon: 'heart', size: 'small', aria_label: 'Add to wishlist' %}
{% endcomment %}

{% liquid
  assign icon = icon | default: ''
  assign size = size | default: 'medium'
  assign class = class | default: ''
  assign aria_label = aria_label | default: icon
  
  unless icon != blank
    echo '<!-- Error: icon parameter required for icon snippet -->'
    break
  endunless
  
  case size
    when 'small'
      assign icon_size = '16'
    when 'large'
      assign icon_size = '24'
    else
      assign icon_size = '20'
  endcase
%}

{% case icon %}
  {% when 'cart' %}
    <svg class="icon icon--{{ size }} {{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"{% if aria_label != blank %} aria-label="{{ aria_label }}"{% endif %}>
      <path d="M5 5H3.5C2.67 5 2 5.67 2 6.5V17.5C2 18.33 2.67 19 3.5 19H16.5C17.33 19 18 18.33 18 17.5V6.5C18 5.67 17.33 5 16.5 5H15M5 5V3.5C5 2.67 5.67 2 6.5 2H13.5C14.33 2 15 2.67 15 3.5V5M5 5H15M7 9V13M13 9V13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {% when 'heart' %}

{% comment %}
  Price Component
  
  This snippet displays product prices with support for sale pricing. When a
  product has a compare-at price (original price), it shows both the original
  price (strikethrough) and the sale price, along with an optional sale badge.
  The component automatically formats prices using Shopify's money filter.
  
  Displays product price with compare-at-price and sale badge.
  
  @param {money} price - Product price (required)
  @param {money} compare_at_price - Compare at price (optional, shows sale if provided)
  @param {string} class - Additional CSS classes
  @param {boolean} show_badge - Show sale badge (default: true if compare_at_price > price)
  @param {string} size - Price size: small, medium, large (default: medium)
  
  @example
  {% render 'price', price: product.price, compare_at_price: product.compare_at_price %}
  {% render 'price', price: variant.price, size: 'large' %}
{% endcomment %}

{% liquid
  assign price = price | default: 0
  assign compare_at_price = compare_at_price | default: 0
  assign class = class | default: ''
  assign size = size | default: 'medium'
  
  assign price_class = 'price price--' | append: size
  if class != blank
    assign price_class = price_class | append: ' ' | append: class
  endif
  
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif
  
  assign show_badge = show_badge | default: on_sale
%}

<div class="{{ price_class }}">
  {% if on_sale %}
    <span class="price__compare">{{ compare_at_price | money }}</span>
    <span class="price__sale">{{ price | money }}</span>
    {% if show_badge %}
      <span class="price__badge">
        {% render 'badge', text: 'Sale', variant: 'sale', size: 'small' %}
      </span>
    {% endif %}
  {% else %}
    <span class="price__regular">{{ price | money }}</span>
  {% endif %}
</div>

{% stylesheet %}
  .price {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }
  
  .price__regular,
  .price__sale {
    font-weight: 600;
    color: var(--color-text);
  }
  
  .price__compare {
    font-size: 0.9em;
    color: var(--color-secondary);
    text-decoration: line-through;
  }
  
  .price__badge {
    margin-left: var(--spacing-xs);
  }
  
  /* Sizes */
  .price--small {
    font-size: 14px;
  }
  
  .price--medium {
    font-size: var(--font-size-body);
  }
  
  .price--large {
    font-size: var(--font-size-h4);
  }
  
  .price--large .price__compare {
    font-size: 0.85em;
  }
{% endstylesheet %}


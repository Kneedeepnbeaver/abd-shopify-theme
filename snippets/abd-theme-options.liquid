{% comment %}
  ABD Theme Options Registry
  
  This is the single source of truth for all ABD theme styles.
  To add a new theme:
  1. Add the CSS to assets/abd-themes.css
  2. Add the theme to the themes array below
  3. Run the update script to sync to all sections
  
  Format: "value|label"
  Example: "premium|Premium Modern"
{% endcomment %}

{% liquid
  assign themes_string = "cable-news|Cable News,california-dreaming|California Dreaming,california-mission|California Mission,cubism|Cubism,disco|Disco,france|France,free-love|Free Love,highway-street-photo|Highway Street Photo,impressionist|Impressionist,italy|Italy,men's-magazine|Men'S Magazine,military-theme|Military Theme,millennial-myspace|Millennial Myspace,national-parks-poster|National Parks Poster,newspaper|Newspaper,nineties-graphic-design|Nineties Graphic Design,renaissance|Renaissance,retro-diner|Retro Diner,retro-internet|Retro Internet,retro-tech-polaroid|Retro Tech Polaroid,stars-and-stripes|Stars And Stripes,stpatricks|Stpatricks,las-vegas|Las Vegas,travel-nyc-liberty|Travel Nyc Liberty,valentines-her|Valentines Her,wayfinding-receipt|Wayfinding Receipt,zine|Zine"
  assign themes_array = themes_string | split: ','
%}

{% comment %}
  Usage in sections:
  {% render 'abd-theme-options' %}
  
  This outputs nothing, but the themes_array variable is available
  for use in generating schema options via scripts.
{% endcomment %}

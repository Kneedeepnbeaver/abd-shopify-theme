{% comment %}
  CSS Variables Snippet
  
  This snippet generates base CSS variables used by critical.css and other global styles.
  Most styling is now handled by ABD Themes (abd-themes.css) via the class applied to the body.
  These variables act as fallbacks or integration points.
{% endcomment %}

{% style %}
  :root {
    {% # Base theme variables - Fallbacks %}
    --font-primary--family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    --font-primary--style: normal;
    --font-primary--weight: 400;
    
    {% # Page Layout %}
    --page-width: 1400px;
    --page-margin: 20px;
    
    {% # Global Colors - Default to White/Black if no theme selected %}
    --color-background: {{ settings.abd_custom_bg_default | default: '#FFFFFF' }};
    --color-foreground: {{ settings.abd_custom_text_default | default: '#000000' }};
    --style-border-radius-inputs: 0px;

    {% # Color scheme variables (Fallbacks for legacy code) %}
    --color-primary: {{ settings.abd_custom_text_default | default: '#000000' }};
    --color-secondary: {{ settings.abd_custom_text_default | default: '#666666' }};
    --color-accent: {{ settings.abd_custom_accent_default | default: '#0066CC' }};
    --color-text: {{ settings.abd_custom_text_default | default: '#000000' }};
    --color-bg: {{ settings.abd_custom_bg_default | default: '#FFFFFF' }};

    {% # Typography scale variables - Defaults %}
    --font-size-h1: 3rem;
    --font-size-h2: 2.25rem;
    --font-size-h3: 1.75rem;
    --font-size-h4: 1.5rem;
    --font-size-h5: 1.25rem;
    --font-size-h6: 1rem;
    --font-size-body: 1rem;
    --font-weight-heading: 700;
    --font-weight-body: 400;
    --line-height-base: 1.5;
    --line-height-heading: 1.2;

    {% # Spacing scale variables %}
    --spacing-section-padding: 60px;
    --spacing-content-gap: 30px;
    --spacing-element-gap: 20px;
    --spacing-xs: 10px;
    --spacing-sm: 20px;
    --spacing-md: 30px;
    --spacing-lg: 30px;
    --spacing-xl: 60px;

    {% # Layout variables %}
    --layout-max-width: 1400px;
    --layout-container-padding: 20px;
  }
{% endstyle %}

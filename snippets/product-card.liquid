{% comment %}
  Product Card Component
  
  This snippet creates a specialized product card designed specifically for
  displaying products in collections and product grids. It includes the product
  image, title, vendor (optional), price with sale badges, and a quick-add button
  that appears on hover. The card is optimized for e-commerce with proper
  product data handling and cart integration.
  
  Specialized product card with image, title, price, and quick add functionality.
  
  @param {product} product - Product object (required)
  @param {boolean} show_vendor - Display vendor name (default: false)
  @param {boolean} show_quick_add - Show quick add button (default: false)
  @param {string} image_ratio - Image aspect ratio: adapt, square, portrait, landscape (default: adapt)
  @param {boolean} lazy_load - Enable lazy loading (default: true)
  @param {string} class - Additional CSS classes
  @param {boolean} show_badge - Show sale badge if product is on sale (default: true)
  
  @example
  {% render 'product-card', product: product, show_vendor: true, show_quick_add: true %}
  {% render 'product-card', product: product, image_ratio: 'square', show_badge: true %}
{% endcomment %}

{% liquid
  assign product = product | default: null
  assign show_vendor = show_vendor | default: false
  assign show_quick_add = show_quick_add | default: false
  assign image_ratio = image_ratio | default: 'adapt'
  assign lazy_load = lazy_load | default: true
  assign class = class | default: ''
  assign show_badge = show_badge | default: true
  
  unless product != null
    echo '<!-- Error: product parameter required for product-card snippet -->'
    break
  endunless
  
  assign card_class = 'product-card'
  if class != blank
    assign card_class = card_class | append: ' ' | append: class
  endif
  
  assign featured_image = product.featured_image | default: product.images.first
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
%}

<div class="{{ card_class }}" data-product-id="{{ product.id }}">
  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title }}">
      {% if featured_image != null %}
        {% render 'image', 
          image: featured_image, 
          alt: featured_image.alt | default: product.title,
          class: 'product-card__image',
          loading: lazy_load | ternary: 'lazy', 'eager',
          width: 600,
          height: 600
        %}
      {% else %}
        <div class="product-card__image product-card__image--placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        </div>
      {% endif %}
      
      {% if on_sale and show_badge %}
        <div class="product-card__badge">
          {% render 'badge', text: 'Sale', variant: 'sale' %}
        </div>
      {% endif %}
    </a>
    
    {% if show_quick_add %}
      <div class="product-card__actions">
        {% if product.available %}
          {% form 'product', product, class: 'product-card__form' %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="product-card__quick-add" aria-label="Add {{ product.title }} to cart">
              {% render 'icon', icon: 'plus', size: 'small' %}
              <span>{{ 'products.add_to_cart' | t }}</span>
            </button>
          {% endform %}
        {% else %}
          <button type="button" class="product-card__quick-add product-card__quick-add--disabled" disabled aria-label="{{ product.title }} is sold out">
            <span>{{ 'products.sold_out' | t }}</span>
          </button>
        {% endif %}
      </div>
    {% endif %}
  </div>
  
  <div class="product-card__content">
    {% if show_vendor and product.vendor != blank %}
      <div class="product-card__vendor">
        {{ product.vendor }}
      </div>
    {% endif %}
    
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    
    <div class="product-card__price">
      {% render 'price', price: product.price, compare_at_price: product.compare_at_price %}
    </div>
  </div>
</div>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    position: relative;
  }
  
  .product-card__image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
    border-radius: 8px;
    margin-bottom: var(--spacing-sm);
  }
  
  .product-card__link {
    display: block;
    position: relative;
    width: 100%;
  }
  
  .product-card__image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--animation-duration-normal) var(--animation-easing);
  }
  
  .product-card__image--placeholder {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }
  
  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }
  
  .product-card__badge {
    position: absolute;
    top: var(--spacing-xs);
    left: var(--spacing-xs);
    z-index: 1;
  }
  
  .product-card__actions {
    position: absolute;
    bottom: var(--spacing-xs);
    left: var(--spacing-xs);
    right: var(--spacing-xs);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity var(--animation-duration-normal) var(--animation-easing),
                transform var(--animation-duration-normal) var(--animation-easing);
  }
  
  .product-card:hover .product-card__actions {
    opacity: 1;
    transform: translateY(0);
  }
  
  .product-card__form {
    width: 100%;
  }
  
  .product-card__quick-add {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    padding: 12px;
    background-color: var(--color-primary);
    color: var(--color-bg);
    border: none;
    border-radius: 4px;
    font-size: var(--font-size-body);
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--animation-duration-fast) var(--animation-easing);
  }
  
  .product-card__quick-add:hover:not(:disabled) {
    background-color: var(--color-secondary);
  }
  
  .product-card__quick-add--disabled {
    background-color: #ccc;
    cursor: not-allowed;
    opacity: 0.6;
  }
  
  .product-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  
  .product-card__vendor {
    font-size: 14px;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .product-card__title {
    margin: 0;
    font-size: var(--font-size-h5);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
  }
  
  .product-card__title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--animation-duration-fast) var(--animation-easing);
  }
  
  .product-card__title a:hover {
    color: var(--color-accent);
  }
  
  .product-card__price {
    font-size: var(--font-size-body);
    font-weight: 500;
  }
{% endstylesheet %}


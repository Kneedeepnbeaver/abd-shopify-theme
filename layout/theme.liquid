<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      ABD Themes use Google Fonts which are preconnected below.
      Legacy Shopify font loading has been removed to support "Theme-First" architecture.
    {% endcomment %}

    {% comment %} Preconnect to Google Fonts for ABD theme fonts {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    
    {% # Load essential theme CSS (non-blocking) %}
    <link rel="preload" href="{{ 'style-variations.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'style-variations.css' | asset_url }}"></noscript>
    
    <link rel="preload" href="{{ 'forms.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'forms.css' | asset_url }}"></noscript>
    
    <link rel="preload" href="{{ 'theme-extensions.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'theme-extensions.css' | asset_url }}"></noscript>
    
    {% # Load ABD theme CSS %}
    {% # Load synchronously to ensure styles work in theme editor preview %}
    {{ 'abd-themes.css' | asset_url | stylesheet_tag }}
    
    {% # Lazy load animations CSS (not critical) %}
    <link rel="preload" href="{{ 'animations.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'animations.css' | asset_url }}"></noscript>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}
    
    {% # Structured Data for SEO %}
    {% render 'structured-data' %}

    {{ content_for_header }}
  </head>

  <body class="{% if settings.abd_theme_default != blank %}abd-theme-{{ settings.abd_theme_default }}{% endif %}">
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
    
    {% section 'cart-drawer' %}

    {% # Load theme JavaScript (deferred for better performance) %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'security.js' | asset_url }}" defer></script>
    {% render 'security-config' %}
  </body>
</html>

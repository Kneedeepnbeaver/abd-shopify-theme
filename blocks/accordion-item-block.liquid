{% liquid
  assign abd_theme = block.settings.abd_theme
  assign custom_bg = block.settings.custom_bg
  assign custom_text = block.settings.custom_text
  assign custom_accent = block.settings.custom_accent
  assign custom_link = block.settings.custom_link
%}
<div class="block-accordion-item-block {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" 
     {{ block.shopify_attributes }}>
  <details class="accordion" {%- if block.settings.open_by_default -%}open{%- endif -%}>
    <summary class="accordion__title abd-title">
      <span class="accordion__title-text">{{ block.settings.heading | default: "Question" }}</span>
      <span class="accordion__icon">
        {%- if block.settings.icon == 'chevron' -%}
          {% render 'icon', icon: 'chevron-down', size: 'small' %}
        {%- elsif block.settings.icon == 'arrow' -%}
          {% render 'icon', icon: 'arrow-down', size: 'small' %}
        {%- else -%}
          {% render 'icon', icon: 'plus', size: 'small' %}
        {%- endif -%}
      </span>
    </summary>
    <div class="accordion__content abd-content">
      {{ block.settings.content }}
      {%- if block.settings.custom_html != blank -%}
        <div class="accordion__custom-html">{{ block.settings.custom_html }}</div>
      {%- endif -%}
    </div>
  </details>
</div>

{% schema %}
{
  "name": "Accordion Item Block",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accordion Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Accordion Content",
      "default": "<p>Accordion content goes here</p>"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "Custom HTML",
      "info": "Optional. Rendered after the content (e.g. embed, form)."
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by Default",
      "default": false
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "default": "plus",
      "options": [
        {
          "label": "Plus/Minus",
          "value": "plus"
        },
        {
          "label": "Chevron",
          "value": "chevron"
        },
        {
          "label": "Arrow",
          "value": "arrow"
        }
      ]
    },
    {
      "type": "header",
      "content": "ABD Theme Styles"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "ca-assembly-daily-file", "label": "CA Assembly Daily File" },

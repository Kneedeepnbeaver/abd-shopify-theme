  assign abd_theme = block.settings.abd_theme

<div class="block-video-block {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" 
     {{ block.shopify_attributes }}>
  {%- if abd_theme == 'retro-internet' -%}<div class="abd-geocities-box">{%- endif -%}
  
  {%- if block.settings.cover_image != blank -%}
    <div class="block-video-block__cover_image">
      {{ block.settings.cover_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.cover_image.alt }}
    </div>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    <div class="block-video-block__heading abd-title">{{ block.settings.heading }}</div>
  {%- endif -%}
  {%- if block.settings.description != blank -%}
    <div class="block-video-block__description abd-content">
      {{ block.settings.description }}
    </div>
  {%- endif -%}
  
  {%- if abd_theme == 'retro-internet' -%}</div>{%- endif -%}
</div>


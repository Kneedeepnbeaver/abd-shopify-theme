{% liquid
  assign abd_theme = block.settings.abd_theme
  assign custom_bg = block.settings.custom_bg
  assign custom_text = block.settings.custom_text
%}

<div class="block-feature-block {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" 
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}"
     {{ block.shopify_attributes }}>
  {%- if abd_theme == 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
  {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
  
  {%- if block.settings.icon_image != blank -%}
    <div class="block-feature-block__icon_image">
      {{ block.settings.icon_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.icon_image.alt }}
    </div>
  {%- endif -%}
  {%- if block.settings.icon_name != blank -%}
    <div class="block-feature-block__icon_name">{{ block.settings.icon_name }}</div>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    <div class="block-feature-block__heading abd-title">{{ block.settings.heading }}</div>
  {%- endif -%}
  {%- if block.settings.description != blank -%}
    <div class="block-feature-block__description abd-content">
      {{ block.settings.description }}
    </div>
  {%- endif -%}
  
  {%- if abd_theme == 'social' -%}</div>{%- endif -%}
  {%- if abd_theme == 'retro' -%}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "Feature Block",
  "settings": [
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon/Image"
    },
    {
      "type": "text",
      "id": "icon_name",
      "label": "Icon Name (if using icon font)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Feature Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Feature Description",
      "default": "<p>Feature description goes here</p>"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "vertical",
      "options": [
        {
          "label": "Vertical",
          "value": "vertical"
        },
        {
          "label": "Horizontal",
          "value": "horizontal"
        }
      ]
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size (px)",
      "default": 48,
      "min": 24,
      "max": 96
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color"
    },
    {
      "type": "header",
      "content": "ABD Theme Styles"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "california-dreaming", "label": "California Dreaming" },
        { "value": "california-mission", "label": "California Mission" },
        { "value": "cubism", "label": "Cubism" },
        { "value": "disco", "label": "Disco" },
        { "value": "france", "label": "France" },
        { "value": "free-love", "label": "Free Love" },
        { "value": "highway-street-photo", "label": "Highway Street Photo" },
        { "value": "impressionist", "label": "Impressionist" },
        { "value": "italy", "label": "Italy" },
        { "value": "men's-magazine", "label": "Men'S Magazine" },
        { "value": "military-theme", "label": "Military Theme" },
        { "value": "millennial-myspace", "label": "Millennial Myspace" },
        { "value": "national-parks-poster", "label": "National Parks Poster" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "nineties-graphic-design", "label": "Nineties Graphic Design" },
        { "value": "renaissance", "label": "Renaissance" },
        { "value": "retro-diner", "label": "Retro Diner" },
        { "value": "retro-internet", "label": "Retro Internet" },
        { "value": "retro-tech-polaroid", "label": "Retro Tech Polaroid" },
        { "value": "stars-and-stripes", "label": "Stars And Stripes" },
        { "value": "stpatricks", "label": "Stpatricks" },
        { "value": "synthwave", "label": "Synthwave" },
        { "value": "travel-nyc-liberty", "label": "Travel Nyc Liberty" },
        { "value": "valentines-her", "label": "Valentines Her" },
        { "value": "wayfinding-receipt", "label": "Wayfinding Receipt" },
        { "value": "zine", "label": "Zine" }
      
      
      
      
      
      
      
      
      
      
      
      ]
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Custom Text Color"
    }
  ],
  "presets": [
    {
      "name": "Feature Block"
    }
  ]
}
{% endschema %}
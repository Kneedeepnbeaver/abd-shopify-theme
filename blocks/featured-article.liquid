{% liquid
  assign abd_theme = block.settings.abd_theme
  assign article = block.settings.setting_1
%}

<div class="block-featured-article {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" {{ block.shopify_attributes }}>
  {%- if abd_theme == 'retro-internet' -%}<div class="abd-geocities-box">{%- endif -%}
  
  {%- if article != blank -%}
    <h2 class="block-featured-article__title abd-title">{{ article.title }}</h2>
    {%- if article.excerpt != blank -%}
      <div class="block-featured-article__excerpt abd-content">{{ article.excerpt }}</div>
    {%- endif -%}
    <a href="{{ article.url }}" class="block-featured-article__link">Read Article</a>
  {%- else -%}
    <div class="abd-content">Select an article to feature</div>
  {%- endif -%}

  {%- if abd_theme == 'retro-internet' -%}</div>{%- endif -%}
</div>


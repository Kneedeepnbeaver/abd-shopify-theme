{% liquid
  assign abd_theme = block.settings.abd_theme
%}
<div class="block-image-and-text-block {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" 
     {{ block.shopify_attributes }}>
  
  {%- if abd_theme == 'retro-internet' -%}<div class="abd-geocities-box">{%- endif -%}
  
  {%- if block.settings.image != blank -%}
    <div class="block-image-and-text-block__image">
      {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}
    </div>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    <div class="block-image-and-text-block__heading abd-title">{{ block.settings.heading }}</div>
  {%- endif -%}
  {%- if block.settings.text != blank -%}
    <div class="block-image-and-text-block__text abd-content">
      {{ block.settings.text }}
    </div>
  {%- endif -%}
  {%- if block.settings.button_text != blank -%}
    <div class="block-image-and-text-block__button_text">{{ block.settings.button_text }}</div>
  {%- endif -%}
  {%- if block.settings.button_link != blank -%}
    <a href="{{ block.settings.button_link }}" class="block-image-and-text-block__link">
      {%- if block.settings.button_text != blank -%}
        {{ block.settings.button_text }}
      {%- else -%}
        Learn More
      {%- endif -%}
    </a>
  {%- endif -%}
  
  {%- if abd_theme == 'retro-internet' -%}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "Image & Text Block",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text Content",
      "default": "<p>Text content goes here</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image-left",
      "options": [
        {
          "label": "Image Left",
          "value": "image-left"
        },
        {
          "label": "Image Right",
          "value": "image-right"
        },
        {
          "label": "Image Top",
          "value": "image-top"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_ratio",
      "label": "Image Ratio (%)",
      "default": 50,
      "min": 30,
      "max": 70
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme"
    },
    {
      "type": "header",
      "content": "ABD Theme Styles"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "california-dreaming", "label": "California Dreaming" },
        { "value": "california-mission", "label": "California Mission" },
        { "value": "cubism", "label": "Cubism" },
        { "value": "disco", "label": "Disco" },
        { "value": "france", "label": "France" },
        { "value": "free-love", "label": "Free Love" },
        { "value": "highway-street-photo", "label": "Highway Street Photo" },
        { "value": "impressionist", "label": "Impressionist" },
        { "value": "italy", "label": "Italy" },
        { "value": "men's-magazine", "label": "Men'S Magazine" },
        { "value": "military-theme", "label": "Military Theme" },
        { "value": "millennial-myspace", "label": "Millennial Myspace" },
        { "value": "national-parks-poster", "label": "National Parks Poster" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "nineties-graphic-design", "label": "Nineties Graphic Design" },
        { "value": "renaissance", "label": "Renaissance" },
        { "value": "retro-diner", "label": "Retro Diner" },
        { "value": "retro-internet", "label": "Retro Internet" },
        { "value": "retro-tech-polaroid", "label": "Retro Tech Polaroid" },
        { "value": "stars-and-stripes", "label": "Stars And Stripes" },
        { "value": "stpatricks", "label": "Stpatricks" },
        { "value": "las-vegas", "label": "Las Vegas" },
        { "value": "travel-nyc-liberty", "label": "Travel Nyc Liberty" },
        { "value": "valentines-her", "label": "Valentines Her" },
        { "value": "wayfinding-receipt", "label": "Wayfinding Receipt" },
        { "value": "zine", "label": "Zine" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image & Text Block"
    }
  ]
}
{% endschema %}
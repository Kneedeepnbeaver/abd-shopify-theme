{% liquid
  assign abd_theme = block.settings.abd_theme | default: section.settings.abd_theme | default: settings.abd_theme_default
  assign product = block.settings.product
%}

<div class="block-product-card-block product-card {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" {{ block.shopify_attributes }}>
  {%- if abd_theme == 'retro-internet' -%}<div class="abd-geocities-box">{%- endif -%}
  
  {%- if product != blank -%}
    {%- if block.settings.show_image and product.featured_image != blank -%}
      <div class="block-product-card-block__image">
        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
      </div>
    {%- endif -%}

    {%- if block.settings.show_title -%}
      <h3 class="block-product-card-block__title product-title abd-title">{{ product.title }}</h3>
    {%- endif -%}

    {%- if block.settings.show_price -%}
      <div class="block-product-card-block__price product-price">{{ product.price | money }}</div>
    {%- endif -%}
  {%- else -%}
    <div class="abd-content">Select a product to display card</div>
  {%- endif -%}

  {%- if abd_theme == 'retro-internet' -%}</div>{%- endif -%}
</div>


{% liquid
  assign abd_theme = block.settings.abd_theme
%}
<div class="block-social-link-block {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" 
     {{ block.shopify_attributes }}>
  {%- if abd_theme == 'retro-internet' -%}<div class="abd-geocities-box">{%- endif -%}
  
  {%- if block.settings.social_url != blank -%}
    <a href="{{ block.settings.social_url }}" class="block-social-link-block__link">
      {%- if block.settings.custom_label != blank -%}
        {{ block.settings.custom_label }}
      {%- else -%}
        {{ block.settings.social_platform | capitalize }}
      {%- endif -%}
    </a>
  {%- elsif block.settings.custom_label != blank -%}
    <div class="block-social-link-block__custom_label">{{ block.settings.custom_label }}</div>
  {%- endif -%}
  
  {%- if abd_theme == 'retro-internet' -%}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "Social Link Block",
  "settings": [
    {
      "type": "select",
      "id": "social_platform",
      "label": "Social Platform",
      "default": "facebook",
      "options": [
        {
          "label": "Facebook",
          "value": "facebook"
        },
        {
          "label": "Twitter",
          "value": "twitter"
        },
        {
          "label": "Instagram",
          "value": "instagram"
        },
        {
          "label": "LinkedIn",
          "value": "linkedin"
        },
        {
          "label": "YouTube",
          "value": "youtube"
        },
        {
          "label": "Pinterest",
          "value": "pinterest"
        },
        {
          "label": "TikTok",
          "value": "tiktok"
        },
        {
          "label": "Custom",
          "value": "custom"
        }
      ]
    },
    {
      "type": "url",
      "id": "social_url",
      "label": "Social Media URL"
    },
    {
      "type": "text",
      "id": "custom_label",
      "label": "Custom Label (if custom platform)"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon Style",
      "default": "default",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Circle",
          "value": "circle"
        },
        {
          "label": "Square",
          "value": "square"
        },
        {
          "label": "Text Only",
          "value": "text"
        }
      ]
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size (px)",
      "default": 32,
      "min": 16,
      "max": 64
    },
    {
      "type": "header",
      "content": "ABD Theme Styles"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "ca-assembly-daily-file", "label": "CA Assembly Daily File" },
        { "value": "california-dreaming", "label": "California Dreaming" },
        { "value": "california-mission", "label": "California Mission" },
        { "value": "cubism", "label": "Cubism" },
        { "value": "disco", "label": "Disco" },
        { "value": "france", "label": "France" },
        { "value": "free-love", "label": "Free Love" },
        { "value": "highway-street-photo", "label": "Highway Street Photo" },
        { "value": "impressionist", "label": "Impressionist" },
        { "value": "italy", "label": "Italy" },
        { "value": "men's-magazine", "label": "Men'S Magazine" },
        { "value": "military-theme", "label": "Military Theme" },
        { "value": "millennial-myspace", "label": "Millennial Myspace" },
        { "value": "national-parks-poster", "label": "National Parks Poster" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "nineties-graphic-design", "label": "Nineties Graphic Design" },
        { "value": "renaissance", "label": "Renaissance" },
        { "value": "retro-diner", "label": "Retro Diner" },
        { "value": "retro-internet", "label": "Retro Internet" },
        { "value": "retro-tech-polaroid", "label": "Retro Tech Polaroid" },
        { "value": "stars-and-stripes", "label": "Stars And Stripes" },
        { "value": "stpatricks", "label": "Stpatricks" },
        { "value": "las-vegas", "label": "Las Vegas" },
        { "value": "travel-nyc-liberty", "label": "Travel Nyc Liberty" },
        { "value": "valentines-her", "label": "Valentines Her" },
        { "value": "wayfinding-receipt", "label": "Wayfinding Receipt" },
        { "value": "zine", "label": "Zine" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Link Block"
    }
  ]
}
{% endschema %}
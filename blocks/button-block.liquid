{% liquid
  assign abd_theme = block.settings.abd_theme
  assign custom_bg = block.settings.custom_bg
  assign custom_text = block.settings.custom_text
%}

<div class="block-button-block block-button-block--{{ block.settings.button_style }} block-button-block--{{ block.settings.button_size }} {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" 
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}"
     {{ block.shopify_attributes }}>
  {%- if block.settings.button_link != blank -%}
    <a href="{{ block.settings.button_link }}" 
       class="block-button-block__link"
       {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
       style="{% if block.settings.button_color != blank %}background-color: {{ block.settings.button_color }};{% endif %} {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}">
      {%- if block.settings.button_text != blank -%}
        {{ block.settings.button_text | escape }}
      {%- else -%}
        Learn More
      {%- endif -%}
    </a>
  {%- elsif block.settings.button_text != blank -%}
    <span class="block-button-block__text"
          style="{% if block.settings.button_color != blank %}background-color: {{ block.settings.button_color }};{% endif %} {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}">
      {{ block.settings.button_text | escape }}
    </span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Button Block",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Click Here"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        {
          "label": "Primary",
          "value": "primary"
        },
        {
          "label": "Secondary",
          "value": "secondary"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Text",
          "value": "text"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button Size",
      "default": "medium",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open in New Tab",
      "default": false
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "header",
      "content": "ABD Theme Styles"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "california-dreaming", "label": "California Dreaming" },
        { "value": "california-mission", "label": "California Mission" },
        { "value": "cubism", "label": "Cubism" },
        { "value": "disco", "label": "Disco" },
        { "value": "france", "label": "France" },
        { "value": "free-love", "label": "Free Love" },
        { "value": "highway-street-photo", "label": "Highway Street Photo" },
        { "value": "impressionist", "label": "Impressionist" },
        { "value": "italy", "label": "Italy" },
        { "value": "men's-magazine", "label": "Men'S Magazine" },
        { "value": "military-theme", "label": "Military Theme" },
        { "value": "millennial-myspace", "label": "Millennial Myspace" },
        { "value": "national-parks-poster", "label": "National Parks Poster" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "nineties-graphic-design", "label": "Nineties Graphic Design" },
        { "value": "renaissance", "label": "Renaissance" },
        { "value": "retro-diner", "label": "Retro Diner" },
        { "value": "retro-internet", "label": "Retro Internet" },
        { "value": "retro-tech-polaroid", "label": "Retro Tech Polaroid" },
        { "value": "stars-and-stripes", "label": "Stars And Stripes" },
        { "value": "stpatricks", "label": "Stpatricks" },
        { "value": "synthwave", "label": "Synthwave" },
        { "value": "travel-nyc-liberty", "label": "Travel Nyc Liberty" },

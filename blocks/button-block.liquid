{% liquid
  assign abd_theme = block.settings.abd_theme
  assign custom_bg = block.settings.custom_bg
  assign custom_text = block.settings.custom_text
%}

<div class="block-button-block block-button-block--{{ block.settings.button_style }} block-button-block--{{ block.settings.button_size }} {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" 
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}"
     {{ block.shopify_attributes }}>
  {%- if block.settings.button_link != blank -%}
    <a href="{{ block.settings.button_link }}" 
       class="block-button-block__link"
       {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
       style="{% if block.settings.button_color != blank %}background-color: {{ block.settings.button_color }};{% endif %} {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}">
      {%- if block.settings.button_text != blank -%}
        {{ block.settings.button_text | escape }}
      {%- else -%}
        Learn More
      {%- endif -%}
    </a>
  {%- elsif block.settings.button_text != blank -%}
    <span class="block-button-block__text"
          style="{% if block.settings.button_color != blank %}background-color: {{ block.settings.button_color }};{% endif %} {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}">
      {{ block.settings.button_text | escape }}
    </span>
  {%- endif -%}
</div>


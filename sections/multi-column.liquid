{% comment %}
  Multi-Column Content Section

  A flexible multi-column layout section that supports:
  - Custom column blocks with heading, content, image, button, and optional custom HTML
  - Custom HTML block type for full-column HTML (embeds, creative layouts)
  - Responsive column layouts (mobile, tablet, desktop)
  - Multiple layout options (grid, masonry, equal height)
  - Alignment and spacing controls
  - Color scheme and typography overrides
  - Unlimited columns (no max_blocks limit)

  Note: Shopify doesn't allow mixing @theme/@app blocks with local blocks
  in the same section. This section uses custom column blocks for maximum
  control. For theme blocks support, use the custom-section.liquid instead.
{% endcomment %}

{% liquid
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_tablet = section.settings.columns_tablet | default: 2
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign layout_style = section.settings.layout_style | default: 'grid'
  assign column_gap = section.settings.column_gap | default: 20
  assign text_alignment = section.settings.text_alignment | default: 'left'
  assign equal_height = section.settings.equal_height
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
  assign show_only_handle = section.settings.show_only_for_handle | strip
%}

{% if show_only_handle == blank or page.handle == show_only_handle %}
<div class="section-multi-column section-multi-column--{{ layout_style }} {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="--columns-mobile: {{ columns_mobile }}; --columns-tablet: {{ columns_tablet }}; --columns-desktop: {{ columns_desktop }}; --column-gap: {{ column_gap }}px; {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-multi-column__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="section-multi-column__heading section-multi-column__heading--{{ text_alignment }} abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-multi-column__text section-multi-column__text--{{ text_alignment }} abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="section-multi-column__grid{% if equal_height %} section-multi-column__grid--equal-height{% endif %}">
        {%- for block in section.blocks -%}
          <div class="section-multi-column__column section-multi-column__column--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'column' -%}
                <div class="multi-column-column">
                  {%- if block.settings.image != blank -%}
                    <div class="multi-column-column__image">
                      {% render 'image',
                        image: block.settings.image,
                        alt: block.settings.heading | default: 'Column image',
                        class: 'multi-column-column__img',
                        loading: 'lazy'
                      %}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.heading != blank -%}
                    <h3 class="multi-column-column__heading abd-title">{{ block.settings.heading }}</h3>
                  {%- endif -%}

                  {%- if block.settings.content != blank -%}
                    <div class="multi-column-column__content abd-content">
                      {{ block.settings.content }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                    <div class="multi-column-column__button">
                      {% render 'button',
                        text: block.settings.button_text,
                        url: block.settings.button_link,
                        variant: block.settings.button_variant | default: 'primary',
                        size: block.settings.button_size | default: 'medium'
                      %}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.custom_html != blank -%}
                    <div class="multi-column-column__custom-html">
                      {{ block.settings.custom_html }}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'product' -%}
                {%- if block.settings.product != blank -%}
                  {%- assign product = all_products[block.settings.product] -%}
                  {%- if product != blank -%}
                    <div class="multi-column-product">
                      {% render 'product-card',
                        product: product,
                        show_vendor: block.settings.show_vendor,
                        show_quick_add: block.settings.show_quick_add,
                        lazy_load: true
                      %}
                    </div>
                  {%- endif -%}
                {%- endif -%}

              {%- when 'collection' -%}
                {%- if block.settings.collection != blank -%}
                  {%- assign collection = collections[block.settings.collection] -%}
                  {%- if collection != blank -%}
                    <div class="multi-column-collection">
                      <a href="{{ collection.url }}" class="multi-column-collection__link">
                        {%- if collection.featured_image != blank -%}
                          <div class="multi-column-collection__image">
                            {% render 'image',
                              image: collection.featured_image,
                              alt: collection.title,
                              class: 'multi-column-collection__img',
                              loading: 'lazy'
                            %}
                          </div>
                        {%- endif -%}
                        <h3 class="multi-column-collection__title">{{ collection.title }}</h3>
                        {%- if block.settings.show_product_count -%}
                          <p class="multi-column-collection__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</p>
                        {%- endif -%}
                      </a>
                    </div>
                  {%- endif -%}
                {%- endif -%}

              {%- when 'article' -%}
                {%- if block.settings.article != blank -%}
                  {%- assign article = articles[block.settings.article] -%}
                  {%- if article != blank -%}
                    <div class="multi-column-article">
                      <a href="{{ article.url }}" class="multi-column-article__link">
                        {%- if article.image != blank -%}
                          <div class="multi-column-article__image">
                            {% render 'image',
                              image: article.image,
                              alt: article.title,
                              class: 'multi-column-article__img',
                              loading: 'lazy'
                            %}
                          </div>
                        {%- endif -%}
                        <h3 class="multi-column-article__title">{{ article.title }}</h3>
                        {%- if block.settings.show_excerpt and article.excerpt != blank -%}
                          <div class="multi-column-article__excerpt">{{ article.excerpt }}</div>
                        {%- elsif block.settings.show_excerpt and article.summary != blank -%}
                          <div class="multi-column-article__excerpt">{{ article.summary | strip_html | truncate: 150 }}</div>
                        {%- endif -%}
                        {%- if block.settings.show_date -%}
                          <time class="multi-column-article__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                            {{ article.published_at | date: '%B %d, %Y' }}
                          </time>
                        {%- endif -%}
                      </a>
                    </div>
                  {%- endif -%}
                {%- endif -%}

              {%- when 'page' -%}
                {%- if block.settings.page != blank -%}
                  {%- assign page = pages[block.settings.page] -%}
                  {%- if page != blank -%}
                    <div class="multi-column-page">
                      <a href="{{ page.url }}" class="multi-column-page__link">
                        {%- if block.settings.show_image and page.metafields.custom.featured_image != blank -%}
                          <div class="multi-column-page__image">
                            {% render 'image',
                              image: page.metafields.custom.featured_image,
                              alt: page.title,
                              class: 'multi-column-page__img',
                              loading: 'lazy'
                            %}
                          </div>
                        {%- endif -%}
                        <h3 class="multi-column-page__title">{{ page.title }}</h3>
                        {%- if block.settings.show_excerpt and page.summary != blank -%}
                          <div class="multi-column-page__excerpt">{{ page.summary | strip_html | truncate: 150 }}</div>
                        {%- endif -%}
                      </a>
                    </div>
                  {%- endif -%}
                {%- endif -%}

              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  <div class="multi-column-image">
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" class="multi-column-image__link">
                    {%- endif -%}
                    {% render 'image',
                      image: block.settings.image,
                      alt: block.settings.alt | default: 'Image',
                      class: 'multi-column-image__img',
                      loading: 'lazy'
                    %}
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.caption != blank -%}
                      <p class="multi-column-image__caption">{{ block.settings.caption }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'text' -%}
                <div class="multi-column-text">
                  {%- if block.settings.heading != blank -%}
                    <h3 class="multi-column-text__heading">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  {%- if block.settings.content != blank -%}
                    <div class="multi-column-text__content">
                      {{ block.settings.content }}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'custom_html' -%}
                {%- if block.settings.html != blank -%}
                  <div class="multi-column-custom-html">
                    {{ block.settings.html }}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-multi-column {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .section-multi-column__heading {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    margin-bottom: var(--spacing-md);
  }

  .section-multi-column__text {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-lg);
  }

  .section-multi-column__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile), 1fr);
    gap: var(--column-gap);
  }

  @media (min-width: 768px) {
    .section-multi-column__grid {
      grid-template-columns: repeat(var(--columns-tablet), 1fr);
    }
  }

  @media (min-width: 1024px) {
    .section-multi-column__grid {
      grid-template-columns: repeat(var(--columns-desktop), 1fr);
    }
  }

  .section-multi-column__grid--equal-height {
    align-items: stretch;
  }

  .section-multi-column__grid--equal-height .section-multi-column__column {
    display: flex;
    flex-direction: column;
  }

  .section-multi-column__grid--equal-height .multi-column-column {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .section-multi-column__grid--equal-height .multi-column-column__content {
    flex: 1;
  }

  .section-multi-column--masonry .section-multi-column__grid {
    grid-auto-rows: masonry;
  }

  .section-multi-column__heading--center,
  .section-multi-column__text--center {
    text-align: center;
  }

  .section-multi-column__heading--right,
  .section-multi-column__text--right {
    text-align: right;
  }

  .multi-column-column {
    padding: var(--spacing-md);
    background-color: var(--color-background);
    border-radius: var(--style-border-radius-inputs);
  }

  .multi-column-column__image {
    margin-bottom: var(--spacing-md);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }

  .multi-column-column__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .multi-column-column__heading {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    margin-bottom: var(--spacing-sm);
  }

  .multi-column-column__content {
    margin-bottom: var(--spacing-md);
  }

  .multi-column-column__content p {
    margin-bottom: var(--spacing-sm);
  }

  .multi-column-column__button {
    margin-top: auto;
  }

  .multi-column-column__custom-html {
    margin-top: var(--spacing-md);
  }

  .multi-column-column__custom-html img {
    max-width: 100%;
    height: auto;
  }

  .multi-column-custom-html {
    padding: var(--spacing-md);
    min-height: 0;
  }

  .multi-column-custom-html img {
    max-width: 100%;
    height: auto;
  }

  /* Product Block Styles */
  .multi-column-product {
    height: 100%;
  }

  /* Collection Block Styles */
  .multi-column-collection__link {
    text-decoration: none;
    color: var(--color-text);
    display: block;
  }

  .multi-column-collection__image {
    margin-bottom: var(--spacing-sm);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }

  .multi-column-collection__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .multi-column-collection__title {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    margin-bottom: var(--spacing-xs);
  }

  .multi-column-collection__count {
    font-size: var(--font-size-body);
    color: var(--color-secondary);
  }

  /* Article Block Styles */
  .multi-column-article__link {
    text-decoration: none;
    color: var(--color-text);
    display: block;
    height: 100%;
  }

  .multi-column-article__image {
    margin-bottom: var(--spacing-sm);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }

  .multi-column-article__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .multi-column-article__title {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    margin-bottom: var(--spacing-xs);
  }

  .multi-column-article__excerpt {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-sm);
    color: var(--color-secondary);
  }

  .multi-column-article__date {
    font-size: 0.875rem;
    color: var(--color-secondary);
  }

  /* Page Block Styles */
  .multi-column-page__link {
    text-decoration: none;
    color: var(--color-text);
    display: block;
    height: 100%;
  }

  .multi-column-page__image {
    margin-bottom: var(--spacing-sm);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }

  .multi-column-page__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .multi-column-page__title {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    margin-bottom: var(--spacing-xs);
  }

  .multi-column-page__excerpt {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    color: var(--color-secondary);
  }

  /* Image Block Styles */
  .multi-column-image {
    width: 100%;
  }

  .multi-column-image__link {
    display: block;
  }

  .multi-column-image__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--style-border-radius-inputs);
  }

  .multi-column-image__caption {
    margin-top: var(--spacing-xs);
    font-size: 0.875rem;
    color: var(--color-secondary);
    text-align: center;
  }

  /* Text Block Styles */
  .multi-column-text {
    padding: var(--spacing-md);
  }

  .multi-column-text__heading {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    margin-bottom: var(--spacing-sm);
  }

  .multi-column-text__content {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}
{% endif %}

{% schema %}
{
  "name": "Multi-Column Content",
  "tag": "section",
  "class": "section-multi-column",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "text",
      "id": "show_only_for_handle",
      "label": "Show only on page handle",
      "info": "Leave blank to show everywhere. Use the page handle (e.g. shipping, returns) to show this section only on that legal page."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p></p>"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "masonry", "label": "Masonry" }
      ]
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "default": 1,
      "min": 1,
      "max": 3,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on Tablet",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap",
      "default": 20,
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "equal_height",
      "label": "Equal Height Columns",
      "default": false,
      "info": "Make all columns the same height"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "ABD Theme Styles"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "california-dreaming", "label": "California Dreaming" },
        { "value": "california-mission", "label": "California Mission" },
        { "value": "cubism", "label": "Cubism" },
        { "value": "disco", "label": "Disco" },
        { "value": "france", "label": "France" },
        { "value": "free-love", "label": "Free Love" },
        { "value": "highway-street-photo", "label": "Highway Street Photo" },
        { "value": "impressionist", "label": "Impressionist" },
        { "value": "italy", "label": "Italy" },
        { "value": "men's-magazine", "label": "Men'S Magazine" },
        { "value": "military-theme", "label": "Military Theme" },
        { "value": "millennial-myspace", "label": "Millennial Myspace" },
        { "value": "national-parks-poster", "label": "National Parks Poster" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "nineties-graphic-design", "label": "Nineties Graphic Design" },
        { "value": "renaissance", "label": "Renaissance" },
        { "value": "retro-diner", "label": "Retro Diner" },
        { "value": "retro-internet", "label": "Retro Internet" },
        { "value": "retro-tech-polaroid", "label": "Retro Tech Polaroid" },
        { "value": "stars-and-stripes", "label": "Stars And Stripes" },
        { "value": "stpatricks", "label": "Stpatricks" },
        { "value": "las-vegas", "label": "Las Vegas" },
        { "value": "travel-nyc-liberty", "label": "Travel Nyc Liberty" },
        { "value": "valentines-her", "label": "Valentines Her" },
        { "value": "wayfinding-receipt", "label": "Wayfinding Receipt" },
        { "value": "zine", "label": "Zine" }
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      ]
    },
    {
      "type": "header",
      "content": "Custom Colors (Optional)"
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Custom Text Color",
      "info": "Overrides the selected ABD theme text color if set."
    },
    {
      "type": "color",
      "id": "custom_accent",

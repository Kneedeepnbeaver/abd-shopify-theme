{% comment %}
  Image with Text Section

  A flexible section that displays images alongside text content. Supports multiple
  layout options, responsive design, and blocks for multiple image+text combinations.
  Can be used for hero sections, feature highlights, or content blocks.
{% endcomment %}

{% liquid
  assign image_position = section.settings.image_position | default: 'left'
  assign layout = section.settings.layout | default: 'split'
  assign text_alignment = section.settings.text_alignment | default: 'left'
  assign mobile_layout = section.settings.mobile_layout | default: 'stacked'
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-image-with-text section-image-with-text--{{ layout }} section-image-with-text--mobile-{{ mobile_layout }} {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}"
     {% if section.settings.color_scheme != blank %}
       data-color-scheme="{{ section.settings.color_scheme }}"
     {% endif %}>
  <div class="section-image-with-text__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="section-image-with-text__heading section-image-with-text__heading--{{ text_alignment }} abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-image-with-text__text section-image-with-text__text--{{ text_alignment }} abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="section-image-with-text__blocks">
        {%- for block in section.blocks -%}
          <div class="section-image-with-text__block section-image-with-text__block--{{ block.settings.image_position | default: image_position }}" {{ block.shopify_attributes }}>
            <div class="image-with-text-item">
              {%- if block.settings.image != blank -%}
                <div class="image-with-text-item__image-wrapper">
                  {%- if block.settings.image_link != blank -%}
                    <a href="{{ block.settings.image_link }}" class="image-with-text-item__image-link">
                  {%- endif -%}
                  {% render 'image',
                    image: block.settings.image,
                    alt: block.settings.heading | default: 'Image',
                    class: 'image-with-text-item__image',
                    loading: 'lazy'
                  %}
                  {%- if block.settings.image_link != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- elsif section.settings.image != blank and forloop.first -%}
                <div class="image-with-text-item__image-wrapper">
                  {%- if section.settings.button_link != blank -%}
                    <a href="{{ section.settings.button_link }}" class="image-with-text-item__image-link">
                  {%- endif -%}
                  {% render 'image',
                    image: section.settings.image,
                    alt: section.settings.heading | default: 'Image',
                    class: 'image-with-text-item__image',
                    loading: 'lazy'
                  %}
                  {%- if section.settings.button_link != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="image-with-text-item__content">
                {%- if block.settings.heading != blank -%}
                  <h3 class="image-with-text-item__heading">{{ block.settings.heading }}</h3>
                {%- elsif section.settings.heading != blank and forloop.first -%}
                  <h3 class="image-with-text-item__heading">{{ section.settings.heading }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="image-with-text-item__text">
                    {{ block.settings.text }}
                  </div>
                {%- elsif section.settings.text != blank and forloop.first -%}
                  <div class="image-with-text-item__text">
                    {{ section.settings.text }}
                  </div>
                {%- endif -%}

                {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                  <div class="image-with-text-item__button">
                    {% render 'button',
                      text: block.settings.button_text,
                      url: block.settings.button_link,
                      variant: block.settings.button_variant | default: 'primary',
                      size: block.settings.button_size | default: 'medium'
                    %}
                  </div>
                {%- elsif section.settings.button_text != blank and section.settings.button_link != blank and forloop.first -%}
                  <div class="image-with-text-item__button">
                    {% render 'button',
                      text: section.settings.button_text,
                      url: section.settings.button_link,
                                            size: section.settings.button_size | default: 'medium'
                    %}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- elsif section.settings.image != blank -%}
      <div class="section-image-with-text__single section-image-with-text__single--{{ image_position }}">
        <div class="image-with-text-item">
          <div class="image-with-text-item__image-wrapper">
            {%- if section.settings.button_link != blank -%}
              <a href="{{ section.settings.button_link }}" class="image-with-text-item__image-link">
            {%- endif -%}
            {% render 'image',
              image: section.settings.image,
              alt: section.settings.heading | default: 'Image',
              class: 'image-with-text-item__image',
              loading: 'lazy'
            %}
            {%- if section.settings.button_link != blank -%}
              </a>
            {%- endif -%}
          </div>

          <div class="image-with-text-item__content">
            {%- if section.settings.heading != blank -%}
              <h3 class="image-with-text-item__heading">{{ section.settings.heading }}</h3>
            {%- endif -%}

            {%- if section.settings.text != blank -%}
              <div class="image-with-text-item__text">
                {{ section.settings.text }}
              </div>
            {%- endif -%}

            {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
              <div class="image-with-text-item__button">
                {% render 'button',
                  text: section.settings.button_text,
                  url: section.settings.button_link,
                                    size: section.settings.button_size | default: 'medium'
                %}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-image-with-text {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .section-image-with-text__heading {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    margin-bottom: var(--spacing-md);
  }

  .section-image-with-text__text {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-lg);
  }

  .section-image-with-text__heading--center,
  .section-image-with-text__text--center {
    text-align: center;
  }

  .section-image-with-text__heading--right,
  .section-image-with-text__text--right {
    text-align: right;
  }

  .image-with-text-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .section-image-with-text__block--right .image-with-text-item,
  .section-image-with-text__single--right .image-with-text-item {
    flex-direction: row-reverse;
  }

  .section-image-with-text--mobile-stacked .image-with-text-item {
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .section-image-with-text--mobile-stacked .image-with-text-item {
      flex-direction: row;
    }

    .section-image-with-text__block--right .image-with-text-item,
    .section-image-with-text__single--right .image-with-text-item {
      flex-direction: row-reverse;
    }
  }

  .section-image-with-text--split .image-with-text-item__image-wrapper {
    flex: 1;
  }

  .section-image-with-text--split .image-with-text-item__content {
    flex: 1;
  }

  .section-image-with-text--image-large .image-with-text-item__image-wrapper {
    flex: 1.5;
  }

  .section-image-with-text--image-large .image-with-text-item__content {
    flex: 1;
  }

  .section-image-with-text--text-large .image-with-text-item__image-wrapper {
    flex: 1;
  }

  .section-image-with-text--text-large .image-with-text-item__content {
    flex: 1.5;
  }

  .image-with-text-item__image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--style-border-radius-inputs);
  }

  .image-with-text-item__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .image-with-text-item__image-link {
    display: block;
  }

  .image-with-text-item__content {
    padding: var(--spacing-md);
  }

  .image-with-text-item__heading {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    margin-bottom: var(--spacing-sm);
  }

  .image-with-text-item__text {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-md);
  }

  .image-with-text-item__text p {
    margin-bottom: var(--spacing-xs);
  }

  .image-with-text-item__button {
    margin-top: var(--spacing-md);
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}


{% comment %}
  Pricing Table Section

  A flexible pricing table section that displays pricing tiers in a responsive grid.
  Each tier can include a name, price, description, features list, and call-to-action button.
  Supports highlighting featured plans and unlimited pricing tiers.
{% endcomment %}

{% liquid
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign columns_tablet = section.settings.columns_tablet | default: 2
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign column_gap = section.settings.column_gap | default: 20
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-pricing-table {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="--columns-mobile: {{ columns_mobile }}; --columns-tablet: {{ columns_tablet }}; --columns-desktop: {{ columns_desktop }}; --column-gap: {{ column_gap }}px; {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-pricing-table__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="section-pricing-table__heading abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-pricing-table__text abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="section-pricing-table__grid">
        {%- for block in section.blocks -%}
          <div class="section-pricing-table__tier{% if block.settings.featured and section.settings.highlight_featured %} section-pricing-table__tier--featured{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.type == 'pricing-tier' -%}
              <div class="pricing-tier">
                {%- if block.settings.featured and section.settings.highlight_featured -%}
                  <div class="pricing-tier__badge">Featured</div>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <h3 class="pricing-tier__heading">{{ block.settings.heading }}</h3>
                {%- endif -%}

                {%- if block.settings.price != blank -%}
                  <div class="pricing-tier__price">
                    <span class="pricing-tier__price-amount">{{ block.settings.price }}</span>
                    {%- if block.settings.price_period != blank -%}
                      <span class="pricing-tier__price-period">/ {{ block.settings.price_period }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <div class="pricing-tier__description">
                    {{ block.settings.description }}
                  </div>
                {%- endif -%}

                {%- if block.settings.features != blank -%}
                  <ul class="pricing-tier__features">
                    {%- assign features = block.settings.features | split: ',' -%}
                    {%- for feature in features -%}
                      <li class="pricing-tier__feature">{{ feature | strip }}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                  <div class="pricing-tier__button">
                    {% render 'button',
                      text: block.settings.button_text,
                      url: block.settings.button_link,
                      variant: block.settings.button_variant | default: 'primary',
                      size: block.settings.button_size | default: 'large'
                    %}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-pricing-table {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .section-pricing-table__heading {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    margin-bottom: var(--spacing-md);
    text-align: center;
  }

  .section-pricing-table__text {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-lg);
    text-align: center;
  }

  .section-pricing-table__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile), 1fr);
    gap: var(--column-gap);
  }

  @media (min-width: 768px) {
    .section-pricing-table__grid {
      grid-template-columns: repeat(var(--columns-tablet), 1fr);
    }
  }

  @media (min-width: 1024px) {
    .section-pricing-table__grid {
      grid-template-columns: repeat(var(--columns-desktop), 1fr);
    }
  }

  .pricing-tier {
    position: relative;
    padding: var(--spacing-lg);
    border: 2px solid var(--color-secondary);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-background);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .section-pricing-table__tier--featured .pricing-tier {
    border-color: var(--color-primary);
    transform: scale(1.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .pricing-tier__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-primary);
    color: white;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: bold;
    text-transform: uppercase;
  }

  .pricing-tier__heading {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    margin-bottom: var(--spacing-sm);
  }

  .pricing-tier__price {
    margin-bottom: var(--spacing-md);
  }

  .pricing-tier__price-amount {
    font-size: 2.5rem;
    font-weight: var(--font-weight-heading);
    color: var(--color-primary);
  }

  .pricing-tier__price-period {
    font-size: 1rem;
    color: var(--color-secondary);
  }

  .pricing-tier__description {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-md);
    color: var(--color-secondary);
  }

  .pricing-tier__features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-lg) 0;
    text-align: left;
  }

  .pricing-tier__feature {
    padding: var(--spacing-xs) 0;
    padding-left: var(--spacing-md);
    position: relative;
  }

  .pricing-tier__feature:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: bold;
  }

  .pricing-tier__button {
    margin-top: auto;
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}


{% comment %}
  Cart Drawer Section
  
  This section renders the AJAX cart drawer content.
  It is intended to be fetched via the Section Rendering API or included in layout/theme.liquid.
{% endcomment %}

{% liquid
  assign abd_theme = settings.abd_theme_default
  if section.settings.abd_theme != blank
    assign abd_theme = section.settings.abd_theme
  endif
  
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
  
  assign free_shipping_threshold = section.settings.free_shipping_threshold | times: 100
  assign cart_total = cart.total_price
  assign remaining_amount = free_shipping_threshold | minus: cart_total
  assign progress_percentage = cart_total | times: 100.0 | divided_by: free_shipping_threshold
  if progress_percentage > 100
    assign progress_percentage = 100
  endif
%}

<div class="cart-drawer-overlay" data-cart-drawer-overlay></div>

<div class="cart-drawer {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}" 
     id="cart-drawer"
     data-section-id="{{ section.id }}" 
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
     
  {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
  
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title abd-title">{{ 'cart.general.title' | t | default: 'Your Cart' }}</h2>
    <button class="cart-drawer__close" aria-label="{{ 'cart.general.close' | t }}" data-cart-drawer-close>
      {% render 'icon', icon: 'close', size: 'medium' %}
    </button>
  </div>
  
  <!-- ... content ... -->
  
  {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
</div>

{% style %}
  .cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  
  .cart-drawer-overlay.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .cart-drawer {
    position: fixed;
    top: 0;
    right: -100%; /* Start off-screen */
    width: 100%;
    max-width: 400px;
    height: 100%;
    background: var(--color-background);
    color: var(--color-foreground);
    border-left: 1px solid var(--color-border);
    box-shadow: -2px 0 10px rgba(0,0,0,0.1);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transition: right 0.3s ease-in-out;
  }
  
  .cart-drawer.is-open {
    right: 0;
  }

  
  .cart-drawer__header {
    padding: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .cart-drawer__title {
    margin: 0;
    font-size: var(--font-size-h3);
  }
  
  .cart-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--color-foreground);
  }
  
  .cart-drawer__shipping-bar {
    padding: var(--spacing-md);
    background-color: var(--color-background-secondary);
    border-bottom: 1px solid var(--color-border);
  }
  
  .cart-drawer__shipping-text {
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    text-align: center;
  }
  
  .cart-drawer__progress-container {
    height: 8px;
    background-color: #e0e0e0;
    border-radius: 4px;
    overflow: hidden;
  }
  
  .cart-drawer__progress-bar {
    height: 100%;
    background-color: var(--color-accent);
    transition: width 0.3s ease;
  }
  
  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: var(--spacing-md);
  }
  
  .cart-drawer-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  
  .cart-drawer-item:last-child {
    border-bottom: none;
  }
  
  .cart-drawer-item__image {
    width: 80px;
    flex-shrink: 0;
    position: relative;
  }
  
  .cart-drawer-item__image img {
    width: 100%;
    height: auto;
    border-radius: var(--style-border-radius-inputs);
    object-fit: cover;
    display: block;
  }
  
  .cart-drawer-item__details {
    flex: 1;
  }
  
  .cart-drawer-item__title {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    line-height: 1.2;
  }
  
  .cart-drawer-item__title a {
    text-decoration: none;
    color: inherit;
  }
  
  .cart-drawer-item__variant {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--color-secondary);
  }
  
  .cart-drawer-item__price {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  
  .cart-drawer-item__actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .cart-drawer-item__quantity {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
  }
  
  .quantity-btn {
    background: none;
    border: none;
    width: 28px;
    height: 28px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .cart-drawer-item__quantity input {
    width: 32px;
    text-align: center;
    border: none;
    padding: 0;
    font-size: 0.9rem;
    -moz-appearance: textfield;
  }
  
  .cart-drawer-item__quantity input::-webkit-outer-spin-button,
  .cart-drawer-item__quantity input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  
  .cart-drawer-item__remove {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.8rem;
    text-decoration: underline;
    cursor: pointer;
    color: var(--color-secondary);
  }
  
  .cart-drawer__footer {
    padding: var(--spacing-md);
    border-top: 1px solid var(--color-border);
    background: var(--color-background);
  }
  
  .cart-drawer__total {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    font-size: 1.1rem;
    font-weight: bold;
  }
  
  .cart-drawer__buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .cart-drawer__buttons .button {
    width: 100%;
    margin-bottom: 0;
  }
  
  .cart-drawer__empty {
    text-align: center;
    padding: 2rem 0;
  }
  
  .cart-drawer__empty p {
    margin-bottom: 1.5rem;
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}


    },
    {
      "type": "header",
      "content": "ABD Theme Styles"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "california-dreaming", "label": "California Dreaming" },
        { "value": "california-mission", "label": "California Mission" },
        { "value": "cubism", "label": "Cubism" },
        { "value": "disco", "label": "Disco" },
        { "value": "france", "label": "France" },
        { "value": "free-love", "label": "Free Love" },
        { "value": "highway-street-photo", "label": "Highway Street Photo" },
        { "value": "impressionist", "label": "Impressionist" },
        { "value": "italy", "label": "Italy" },
        { "value": "men's-magazine", "label": "Men'S Magazine" },
        { "value": "military-theme", "label": "Military Theme" },
        { "value": "millennial-myspace", "label": "Millennial Myspace" },
        { "value": "national-parks-poster", "label": "National Parks Poster" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "nineties-graphic-design", "label": "Nineties Graphic Design" },
        { "value": "renaissance", "label": "Renaissance" },
        { "value": "retro-diner", "label": "Retro Diner" },
        { "value": "retro-internet", "label": "Retro Internet" },
        { "value": "retro-tech-polaroid", "label": "Retro Tech Polaroid" },
        { "value": "stars-and-stripes", "label": "Stars And Stripes" },
        { "value": "stpatricks", "label": "Stpatricks" },
        { "value": "las-vegas", "label": "Las Vegas" },
        { "value": "travel-nyc-liberty", "label": "Travel Nyc Liberty" },
        { "value": "valentines-her", "label": "Valentines Her" },
        { "value": "wayfinding-receipt", "label": "Wayfinding Receipt" },
        { "value": "zine", "label": "Zine" }
      ]
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Custom Text Color"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "Custom Accent Color"
    },
    {
      "type": "color",
      "id": "custom_link",
      "label": "Custom Link Color"
    }
  ]
}
{% endschema %}

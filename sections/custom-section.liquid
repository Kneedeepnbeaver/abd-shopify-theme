{% liquid
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="custom-section full-width {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="padding-top: {{ section.settings.padding_top | default: 60 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px; {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  {% if section.settings.background_image %}
    <div class="custom-section__background">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
    </div>
  {% endif %}

  <div class="custom-section__content">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    {% content_for 'blocks' %}
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  .custom-section {
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .custom-section__background {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
  }
  .custom-section__background img {
    position: absolute;
    width: 100%;
    height: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .custom-section__content {
    display: grid;
    grid-template-columns: var(--content-grid);
  }
  .custom-section__content > * {
    grid-column: 2;
  }
{% endstylesheet %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}


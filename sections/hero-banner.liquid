{% comment %}
  Hero Banner Section
  
  This section creates a hero banner (large promotional area) typically used
  at the top of the homepage or landing pages. It displays a heading, text,
  optional image background, and a call-to-action button. The section supports
  multiple layout variations (centered, left, right), color scheme overrides,
  and spacing presets. The image can have an overlay for better text readability.
{% endcomment %}

{% liquid
  assign layout_variation = section.settings.layout_variation | default: 'centered'
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
  
  assign section_class = 'section-hero-banner'
  if layout_variation != 'default'
    assign section_class = section_class | append: ' layout-' | append: layout_variation
  endif
  if abd_theme != blank
    assign section_class = section_class | append: ' abd-theme-' | append: abd_theme
  endif
  
  if section.settings.full_width
    assign section_class = section_class | append: ' full-width'
  endif

  assign image_loading = section.settings.image_loading | default: 'eager'
  assign image_opacity = section.settings.image_opacity | default: 100
  assign overlay_color = section.settings.overlay_color
  assign overlay_opacity = section.settings.overlay_opacity | default: 0
  assign show_only_handle = section.settings.show_only_for_handle | strip
%}

{% if show_only_handle == blank or page.handle == show_only_handle %}
<div class="{{ section_class }}"
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  {% if section.settings.image != blank %}
    <div class="section-hero-banner__image-wrapper">
      {% render 'image', 
        image: section.settings.image, 
        alt: section.settings.heading | default: 'Hero banner',
        class: 'section-hero-banner__image',
        loading: image_loading
      %}
      {% if overlay_opacity > 0 %}
        <div class="section-hero-banner__overlay" style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity | divided_by: 100.0 }};"></div>
      {% endif %}
    </div>
  {% endif %}
  
  {%- if abd_theme == 'retro-internet' -%}<div class="abd-geocities-box">{%- endif -%}
  
  <div class="section-hero-banner__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-hero-banner__heading abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-hero-banner__text abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif %}

    {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
      <div class="section-hero-banner__button">
        {% render 'button', 
          text: section.settings.button_text, 
          url: section.settings.button_link,
          size: section.settings.button_size | default: 'large'
        %}
      </div>
    {%- endif %}

    {%- if section.settings.custom_html != blank -%}
      <div class="section-hero-banner__custom-html">
        {{ section.settings.custom_html }}
      </div>
    {%- endif %}
  </div>
  
  {%- if abd_theme == 'retro-internet' -%}</div>{%- endif -%}
</div>

{% style %}
  .section-hero-banner {
    position: relative;
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    min-height: {{ section.settings.min_height | default: 400 }}px;
    display: flex;
    overflow: hidden;
  }

    justify-content: center;
    align-items: center;
  }
  
  .section-hero-banner__image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }
  
  .section-hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: {{ image_opacity | divided_by: 100.0 }};
  }
  
  .section-hero-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  
  
  .section-hero-banner__container {
    position: relative;
    z-index: 2;
    max-width: 800px;
    width: 100%;
    padding: var(--spacing-lg) var(--layout-container-padding);
    text-align: center;
  }
  
  .section-hero-banner.layout-left .section-hero-banner__container {
    text-align: left;
  }
  
  .section-hero-banner.layout-right .section-hero-banner__container {
    text-align: right;
  }

  .section-hero-banner__custom-html {
    margin-top: var(--spacing-md);
  }

  .section-hero-banner__custom-html img {
    max-width: 100%;
    height: auto;
  }
  
  /* Split Layout */
  .section-hero-banner.layout-split {
    flex-direction: row;
    align-items: stretch;
    min-height: 500px;
  }
  
  .section-hero-banner.layout-split .section-hero-banner__image-wrapper {
    position: relative;
    width: 50%;
    height: auto;
  }
  
  .section-hero-banner.layout-split .section-hero-banner__container {
    width: 50%;
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  @media (max-width: 768px) {
    .section-hero-banner.layout-split {
      flex-direction: column;
    }
    
    .section-hero-banner.layout-split .section-hero-banner__image-wrapper,
    .section-hero-banner.layout-split .section-hero-banner__container {
      width: 100%;
    }
  }
  
  .section-hero-banner__heading {
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }
  
  .section-hero-banner__text {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    color: var(--color-text);
    margin-bottom: var(--spacing-lg);
  }
  
  .section-hero-banner__button {
    margin-top: var(--spacing-md);
  }
  .section-hero-banner.full-width {
    width: 100%;
    max-width: none;
    margin: 0;
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}
{% endif %}

{% schema %}

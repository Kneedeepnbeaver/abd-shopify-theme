{% liquid
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="newsletter-section {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; 
            {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} 
            {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  
  <div class="newsletter-section__container">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}

    <div class="newsletter-section__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter-section__heading abd-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="newsletter-section__text abd-content">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-section__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-section__field-wrapper">
          <div class="field">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="newsletter-section__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="Newsletter-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="Newsletter-success--{{ section.id }}"
              {% endif %}
              placeholder="Email address"
              required
            >
            <label class="field__label" for="NewsletterForm--{{ section.id }}">
              Email address
            </label>
            <button
              type="submit"
              class="newsletter-section__button button"
              name="commit"
              id="Subscribe--{{ section.id }}"
              aria-label="Subscribe"
            >
              Subscribe
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-section__error form__message" id="Newsletter-error--{{ section.id }}">
              {% render 'icon', icon: 'error' %}
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>
        {%- if form.posted_successfully? -%}
          <h3
            class="newsletter-section__success form__message"
            id="Newsletter-success--{{ section.id }}"
            tabindex="-1"
            autofocus
          >
            {% render 'icon', icon: 'success' %}
            Thanks for subscribing!
          </h3>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  .newsletter-section {
    width: 100%;
    overflow: hidden;
  }
  .newsletter-section__container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .newsletter-section__content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .newsletter-section__heading {
    margin-bottom: 1.5rem;
  }
  .newsletter-section__text {
    margin-bottom: 2.5rem;
    max-width: 60ch;
  }
  .newsletter-section__form {
    width: 100%;
    max-width: 500px;
  }
  .newsletter-section__field-wrapper {
    margin-bottom: 2rem;
  }
  .newsletter-section .field {
    display: flex;
    position: relative;
    width: 100%;
  }
  .newsletter-section__input {
    flex-grow: 1;
    padding: 1.5rem;
    border: 1px solid var(--color-border, #ccc);
    font-family: inherit;
    background: transparent;
    color: currentColor;
  }
  .newsletter-section .field__label {
    position: absolute;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    transition: all 0.2s ease;
    opacity: 0.5;
  }
  .newsletter-section__input:focus + .field__label,
  .newsletter-section__input:not(:placeholder-shown) + .field__label {
    top: 0.5rem;
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .newsletter-section__button {
    padding: 0 2.5rem;
    white-space: nowrap;
  }
{% endstylesheet %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Be the first to know about new collections and exclusive offers.</p>"
    },
    {
      "type": "header",
      "content": "ABD Theme Styles"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "ca-assembly-daily-file", "label": "CA Assembly Daily File" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "california-dreaming", "label": "California Dreaming" },
        { "value": "california-mission", "label": "California Mission" },
        { "value": "cubism", "label": "Cubism" },
        { "value": "disco", "label": "Disco" },
        { "value": "france", "label": "France" },
        { "value": "free-love", "label": "Free Love" },
        { "value": "highway-street-photo", "label": "Highway Street Photo" },
        { "value": "impressionist", "label": "Impressionist" },
        { "value": "italy", "label": "Italy" },
        { "value": "mens-magazine", "label": "Men'S Magazine" },
        { "value": "military-theme", "label": "Military Theme" },
        { "value": "millennial-myspace", "label": "Millennial Myspace" },
        { "value": "national-parks-poster", "label": "National Parks Poster" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "nineties-graphic-design", "label": "Nineties Graphic Design" },
        { "value": "renaissance", "label": "Renaissance" },
        { "value": "retro-diner", "label": "Retro Diner" },
        { "value": "retro-internet", "label": "Retro Internet" },
        { "value": "retro-tech-polaroid", "label": "Retro Tech Polaroid" },
        { "value": "stars-and-stripes", "label": "Stars And Stripes" },
        { "value": "stpatricks", "label": "Stpatricks" },
        { "value": "las-vegas", "label": "Las Vegas" },
        { "value": "travel-nyc-liberty", "label": "Travel Nyc Liberty" },
        { "value": "valentines-her", "label": "Valentines Her" },
        { "value": "wayfinding-receipt", "label": "Wayfinding Receipt" },
        { "value": "zine", "label": "Zine" }
      ]
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Custom Text Color"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}

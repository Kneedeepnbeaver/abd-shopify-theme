{% comment %}
  Feature Grid Section

  A flexible feature grid section that displays features in a responsive grid layout.
  Each feature can include an icon/image, heading, content, and optional link.
  Supports unlimited features, responsive columns, and various styling options.
{% endcomment %}

{% liquid
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign columns_tablet = section.settings.columns_tablet | default: 2
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign column_gap = section.settings.column_gap | default: 20
  assign text_alignment = section.settings.text_alignment | default: 'left'
  assign equal_height = section.settings.equal_height
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-feature-grid {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="--columns-mobile: {{ columns_mobile }}; --columns-tablet: {{ columns_tablet }}; --columns-desktop: {{ columns_desktop }}; --column-gap: {{ column_gap }}px; {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-feature-grid__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="section-feature-grid__heading section-feature-grid__heading--{{ text_alignment }} abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-feature-grid__text section-feature-grid__text--{{ text_alignment }} abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="section-feature-grid__grid{% if equal_height %} section-feature-grid__grid--equal-height{% endif %}">
        {%- for block in section.blocks -%}
          <div class="section-feature-grid__feature" {{ block.shopify_attributes }}>
            {%- if block.type == 'feature' -%}
              <div class="feature-item">
                {%- if block.settings.icon != blank -%}
                  <div class="feature-item__icon">
                    {% render 'icon', icon: block.settings.icon, size: block.settings.icon_size | default: 'large' %}
                  </div>
                {%- elsif block.settings.image != blank -%}
                  <div class="feature-item__image">
                    {% render 'image',
                      image: block.settings.image,
                      alt: block.settings.heading | default: 'Feature',
                      class: 'feature-item__img',
                      loading: 'lazy'
                    %}
                  </div>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <h3 class="feature-item__heading">{{ block.settings.heading }}</h3>
                {%- endif -%}

                {%- if block.settings.content != blank -%}
                  <div class="feature-item__content">
                    {{ block.settings.content }}
                  </div>
                {%- endif -%}

                {%- if block.settings.link_text != blank and block.settings.link_url != blank -%}
                  <div class="feature-item__link">
                    <a href="{{ block.settings.link_url }}" class="feature-item__link-text">
                      {{ block.settings.link_text }}
                      {% if block.settings.show_link_arrow %}
                        <span class="feature-item__link-arrow">→</span>
                      {% endif %}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-feature-grid {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .section-feature-grid__heading {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    margin-bottom: var(--spacing-md);
  }

  .section-feature-grid__text {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-lg);
  }

  .section-feature-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile), 1fr);
    gap: var(--column-gap);
  }

  @media (min-width: 768px) {
    .section-feature-grid__grid {
      grid-template-columns: repeat(var(--columns-tablet), 1fr);
    }
  }

  @media (min-width: 1024px) {
    .section-feature-grid__grid {
      grid-template-columns: repeat(var(--columns-desktop), 1fr);
    }
  }

  .section-feature-grid__grid--equal-height {
    align-items: stretch;
  }

  .section-feature-grid__grid--equal-height .section-feature-grid__feature {
    display: flex;
    flex-direction: column;
  }

  .section-feature-grid__grid--equal-height .feature-item {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .section-feature-grid__grid--equal-height .feature-item__content {
    flex: 1;
  }

  .section-feature-grid__heading--center,
  .section-feature-grid__text--center {
    text-align: center;
  }

  .section-feature-grid__heading--right,
  .section-feature-grid__text--right {
    text-align: right;
  }

  .feature-item {
    padding: var(--spacing-md);
    text-align: {{ text_alignment }};
  }

  .feature-item__icon {
    margin-bottom: var(--spacing-sm);
    display: flex;
    align-items: center;
    justify-content: {{ text_alignment }};
  }

  .feature-item__icon svg {
    width: 48px;
    height: 48px;
    fill: var(--color-primary);
  }

  .feature-item__image {
    margin-bottom: var(--spacing-sm);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }

  .feature-item__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .feature-item__heading {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    margin-bottom: var(--spacing-sm);
  }

  .feature-item__content {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-md);
  }

  .feature-item__content p {
    margin-bottom: var(--spacing-xs);
  }

  .feature-item__link {
    margin-top: auto;
  }

  .feature-item__link-text {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .feature-item__link-text:hover {
    text-decoration: underline;
  }

  .feature-item__link-arrow {
    transition: transform 0.2s ease;
  }

  .feature-item__link-text:hover .feature-item__link-arrow {
    transform: translateX(4px);
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}


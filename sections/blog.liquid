{% comment %}
  Blog Section

  This section displays a list of blog articles (blog posts) in a blog.
  It shows the blog title, description, and a paginated list of articles with
  their images, titles, dates, authors, and excerpts. The section supports
  multiple layout options (grid, list, masonry) and can override color schemes
  and spacing to match different design needs.

  Enhanced with:
  - Better article card styling
  - Responsive column controls
  - Improved typography
  - Article metadata display
{% endcomment %}

{% liquid
  assign layout_variation = section.settings.layout_variation | default: 'grid'
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign columns_tablet = section.settings.columns_tablet | default: 2
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign articles_per_page = section.settings.articles_per_page | default: 5
  assign show_excerpt = section.settings.show_excerpt
  assign show_date = section.settings.show_date
  assign show_author = section.settings.show_author
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-blog section-blog--{{ layout_variation }} {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="--columns-mobile: {{ columns_mobile }}; --columns-tablet: {{ columns_tablet }}; --columns-desktop: {{ columns_desktop }}; {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-blog__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    <div class="blog-header">
      <h1 class="blog-header__title abd-title">{{ blog.title }}</h1>
      
      {%- if blog.description != blank -%}
        <div class="blog-header__description">
          {{ blog.description }}
        </div>
      {%- endif -%}
    </div>

    <div class="blog-articles">
      {% paginate blog.articles by articles_per_page %}
        {%- if blog.articles.size > 0 -%}
          <div class="blog-articles__grid">
            {% for article in blog.articles %}
              <article class="blog-article">
                {%- if article.image -%}
                  <div class="blog-article__image">
                    <a href="{{ article.url }}" class="blog-article__image-link">
                      {% render 'image',
                        image: article.image,
                        alt: article.title,
                        class: 'blog-article__img',
                        loading: 'lazy'
                      %}
                    </a>
                  </div>
                {%- endif -%}

                <div class="blog-article__content">
                  <h2 class="blog-article__title">
                    <a href="{{ article.url }}">{{ article.title }}</a>
                  </h2>

                  {%- if show_date or show_author -%}
                    <div class="blog-article__meta">
                      {%- if show_date -%}
                        <time class="blog-article__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                          {{ article.published_at | date: '%B %d, %Y' }}
                        </time>
                      {%- endif -%}
                      {%- if show_date and show_author -%}
                        <span class="blog-article__meta-separator">•</span>
                      {%- endif -%}
                      {%- if show_author and article.author != blank -%}
                        <span class="blog-article__author">{{ article.author }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- if show_excerpt and article.excerpt != blank -%}
                    <div class="blog-article__excerpt">
                      {{ article.excerpt }}
                    </div>
                  {%- elsif show_excerpt and article.summary != blank -%}
                    <div class="blog-article__excerpt">
                      {{ article.summary | strip_html | truncate: 150 }}
                    </div>
                  {%- endif -%}

                  <a href="{{ article.url }}" class="blog-article__read-more">
                    {{ 'blog.article.read_more' | t | default: 'Read more' }} →
                  </a>
                </div>
              </article>
            {% endfor %}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="blog-articles__pagination">
              {{ paginate | default_pagination }}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="blog-articles__empty">
            <p>{{ 'blog.no_articles' | t | default: 'No articles found.' }}</p>
          </div>
        {%- endif -%}
      {% endpaginate %}
    </div>
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-blog {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .blog-header {
    margin-bottom: var(--spacing-xl);
    text-align: center;
  }

  .blog-header__title {
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    margin-bottom: var(--spacing-md);
  }

  .blog-header__description {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .blog-articles__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile), 1fr);
    gap: var(--spacing-lg);
  }

  @media (min-width: 768px) {
    .blog-articles__grid {
      grid-template-columns: repeat(var(--columns-tablet), 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-articles__grid {
      grid-template-columns: repeat(var(--columns-desktop), 1fr);
    }
  }

  .section-blog--list .blog-articles__grid {
    grid-template-columns: 1fr;
  }

  .section-blog--masonry .blog-articles__grid {
    grid-auto-rows: masonry;
  }

  .blog-article {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .blog-article:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .blog-article__image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .blog-article__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-article__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-article:hover .blog-article__img {
    transform: scale(1.05);
  }

  .blog-article__content {
    padding: var(--spacing-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .blog-article__title {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    margin-bottom: var(--spacing-sm);
  }

  .blog-article__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .blog-article__title a:hover {
    color: var(--color-primary);
  }

  .blog-article__meta {
    font-size: 0.875rem;
    color: var(--color-secondary);
    margin-bottom: var(--spacing-sm);
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .blog-article__meta-separator {
    color: var(--color-secondary);
  }

  .blog-article__excerpt {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    flex: 1;
  }

  .blog-article__read-more {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    align-self: flex-start;
  }

  .blog-article__read-more:hover {
    text-decoration: underline;
  }

  .blog-articles__pagination {
    margin-top: var(--spacing-xl);
    text-align: center;
  }

  .blog-articles__empty {
    text-align: center;
    padding: var(--spacing-xl);
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link

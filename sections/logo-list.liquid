{% comment %}
  Logo List Section

  A flexible logo list section for displaying partner logos, client logos, or brand
  logos. Supports unlimited logos, responsive columns, grayscale effects, and links.
{% endcomment %}

{% liquid
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign columns_tablet = section.settings.columns_tablet | default: 4
  assign columns_desktop = section.settings.columns_desktop | default: 5
  assign logo_opacity = section.settings.logo_opacity | default: 60
  assign grayscale = section.settings.grayscale
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-logo-list {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="--columns-mobile: {{ columns_mobile }}; --columns-tablet: {{ columns_tablet }}; --columns-desktop: {{ columns_desktop }}; --logo-opacity: {{ logo_opacity }}%; {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-logo-list__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="section-logo-list__heading abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-logo-list__text abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="section-logo-list__grid">
        {%- for block in section.blocks -%}
          <div class="section-logo-list__logo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="logo-item{% if grayscale %} logo-item--grayscale{% endif %}">
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="logo-item__link" target="{{ block.settings.link_target }}" rel="noopener noreferrer">
                {%- endif -%}
                
                {% render 'image',
                  image: block.settings.image,
                  alt: block.settings.heading | default: 'Logo',
                  class: 'logo-item__image',
                  loading: 'lazy'
                %}
                
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-logo-list {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .section-logo-list__heading {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    margin-bottom: var(--spacing-md);
    text-align: center;
  }

  .section-logo-list__text {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-lg);
    text-align: center;
  }

  .section-logo-list__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile), 1fr);
    gap: var(--spacing-lg);
    align-items: center;
  }

  @media (min-width: 768px) {
    .section-logo-list__grid {
      grid-template-columns: repeat(var(--columns-tablet), 1fr);
    }
  }

  @media (min-width: 1024px) {
    .section-logo-list__grid {
      grid-template-columns: repeat(var(--columns-desktop), 1fr);
    }
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-md);
    opacity: var(--logo-opacity);
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  .logo-item--grayscale {
    filter: grayscale(100%);
  }

  .logo-item:hover {
    opacity: 1;
  }

  .logo-item--grayscale:hover {
    filter: grayscale(0%);
  }

  .logo-item__link {
    display: block;
    width: 100%;
    text-align: center;
  }

  .logo-item__image {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    max-height: 80px;
    object-fit: contain;
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}

{% schema %}
{
  "name": "Logo List",
  "tag": "section",
  "class": "section-logo-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",

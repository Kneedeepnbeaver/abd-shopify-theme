{% liquid
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="accordion-section {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; 
            {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} 
            {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  
  <div class="accordion-section__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="accordion-section__heading abd-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    
    {%- if section.settings.text != blank -%}
      <div class="accordion-section__text abd-content">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="accordion-section__items">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'accordion_item' -%}
            {% render 'accordion-item-block', block: block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .accordion-section {
    width: 100%;
    position: relative;
  }
  .accordion-section__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .accordion-section__heading {
    text-align: center;
    margin-bottom: 2rem;
  }
  .accordion-section__text {
    text-align: center;
    margin-bottom: 3rem;
    opacity: 0.8;
  }
  .accordion-section__items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  /* Icon styling for the summary */
  .accordion__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .accordion__icon {
    transition: transform 0.3s ease;
  }
  details[open] .accordion__icon {
    transform: rotate(180deg);
  }
{% endstylesheet %}


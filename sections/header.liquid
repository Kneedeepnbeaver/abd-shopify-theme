{% comment %}
  Header Section
  
  This section creates the site header with logo, navigation menu, and cart icon.
  It includes mobile menu functionality and dynamic cart count updates via JavaScript.
{% endcomment %}

{% liquid
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<header class="{% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
        style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
  {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
  <button class="header__menu-toggle" data-mobile-menu-toggle aria-label="Toggle menu">
    {% render 'icon', icon: 'menu', size: 'medium' %}
  </button>

  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <nav class="header__menu" data-mobile-menu>
    <button class="header__menu-close" data-mobile-menu-close aria-label="Close menu">
      {% render 'icon', icon: 'close', size: 'medium' %}
    </button>
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </nav>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <a href="{{ routes.account_url }}" aria-label="Account">
        {% render 'icon', icon: 'user', size: 'medium' %}
      </a>
    {% endif %}

    <a href="{{ routes.cart_url }}" class="header__cart-link" aria-label="Cart">
      <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      {% render 'icon', icon: 'cart', size: 'medium' %}
    </a>
  </div>
  
  {%- if abd_theme == 'social' -%}</div>{%- endif -%}
  {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
</header>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--layout-container-padding);
    position: relative;
    z-index: 100;
  }

  .header__menu-toggle {
    display: none;
  }

  .header__menu-close {
    display: none;
  }

  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .header__cart-link {
    position: relative;
  }

  .header__cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--color-accent);
    color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    min-width: 20px;
  }

  .header__cart-count:empty {
    display: none;
  }

  header svg {
    width: 2rem;
    height: 2rem;
  }

  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  @media (max-width: 768px) {
    .header__menu-toggle {
      display: block;
      background: none;
      border: none;
      padding: 8px;
      cursor: pointer;
      color: var(--color-foreground);
    }

    .header__menu-close {
      display: block;
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      padding: 8px;
      cursor: pointer;
      color: var(--color-foreground);
    }
  }
{% endstylesheet %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link

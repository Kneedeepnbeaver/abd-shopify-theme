{% comment %}
  Product Grid Section
  
  This section displays a grid of products from a selected collection.
  It supports customizable columns for mobile and desktop, and can show
  vendor names and ratings. Products are displayed using the product-card
  component for consistency.
{% endcomment %}

{% comment %}
  Product Grid Section
  
  This section displays a grid of products from a selected collection.
  It supports customizable columns for mobile and desktop, and can show
  vendor names and ratings. Products are displayed using the product-card
  component for consistency.
{% endcomment %}

{% liquid
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-product-grid {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-product-grid__container">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="section-product-grid__heading abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-product-grid__text abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
      
      {%- if collection.products.size > 0 -%}
        <div class="product-grid" 
             style="--columns-mobile: {{ section.settings.columns_mobile }}; --columns-desktop: {{ section.settings.columns_desktop }};">
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <div class="product-grid__item">
              {% render 'product-card', 
                product: product,
                show_vendor: section.settings.show_vendor,
                show_quick_add: true,
                lazy_load: true
              %}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>No products found in this collection.</p>
      {%- endif -%}
    {%- else -%}
      <p>Please select a collection to display products.</p>
    {%- endif -%}
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-product-grid {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile, 2), 1fr);
    gap: var(--spacing-md);
  }

  @media (min-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(var(--columns-desktop, 4), 1fr);
    }
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "section-product-grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "default": 8,
      "min": 2,
      "max": 50,
      "step": 1
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "default": 4,
      "min": 2,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "header",
      "content": "Theme Style"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "california-dreaming", "label": "California Dreaming" },
        { "value": "california-mission", "label": "California Mission" },
        { "value": "cubism", "label": "Cubism" },
        { "value": "disco", "label": "Disco" },
        { "value": "france", "label": "France" },
        { "value": "free-love", "label": "Free Love" },
        { "value": "highway-street-photo", "label": "Highway Street Photo" },
        { "value": "impressionist", "label": "Impressionist" },
        { "value": "italy", "label": "Italy" },
        { "value": "men's-magazine", "label": "Men'S Magazine" },
        { "value": "military-theme", "label": "Military Theme" },
        { "value": "millennial-myspace", "label": "Millennial Myspace" },
        { "value": "national-parks-poster", "label": "National Parks Poster" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "nineties-graphic-design", "label": "Nineties Graphic Design" },
        { "value": "renaissance", "label": "Renaissance" },
        { "value": "retro-diner", "label": "Retro Diner" },
        { "value": "retro-internet", "label": "Retro Internet" },
        { "value": "retro-tech-polaroid", "label": "Retro Tech Polaroid" },
        { "value": "stars-and-stripes", "label": "Stars And Stripes" },
        { "value": "stpatricks", "label": "Stpatricks" },
        { "value": "synthwave", "label": "Synthwave" },
        { "value": "travel-nyc-liberty", "label": "Travel Nyc Liberty" },
        { "value": "valentines-her", "label": "Valentines Her" },
        { "value": "wayfinding-receipt", "label": "Wayfinding Receipt" },
        { "value": "zine", "label": "Zine" }
      ]
    },
    {
      "type": "header",
      "content": "Custom Colors (Optional)"
    },
    {
      "type": "paragraph",
      "content": "Overrides the selected theme's default colors."
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Custom Background"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Custom Text"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "Custom Accent"
    },
    {
      "type": "color",
      "id": "custom_link",
      "label": "Custom Link"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Product Grid",
      "settings": {
        "heading": "Featured Products",
        "products_to_show": 8,
        "columns_mobile": 2,
        "columns_desktop": 4,
        "show_vendor": false,
        "show_rating": true
      }
    }
  ]
}
{% endschema %}
{% liquid
  assign abd_theme = section.settings.abd_theme

  if page.metafields.custom.abd_theme != blank
    assign abd_theme = page.metafields.custom.abd_theme
  elsif product.metafields.custom.abd_theme != blank
    assign abd_theme = product.metafields.custom.abd_theme
  elsif collection.metafields.custom.abd_theme != blank
    assign abd_theme = collection.metafields.custom.abd_theme
  elsif article.metafields.custom.abd_theme != blank
    assign abd_theme = article.metafields.custom.abd_theme
  elsif blog.metafields.custom.abd_theme != blank
    assign abd_theme = blog.metafields.custom.abd_theme
  endif
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<footer class="{% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
        style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
  {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
  
  <div class="footer__copyright">
    &copy;
    {{ 'now' | date: '%Y' }}
    {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}
  </div>

  <div class="footer__links">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="footer__content">
    {% for block in section.blocks %}
      {% if block.type == 'newsletter' %}
        <div class="footer__newsletter" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h3 class="footer__newsletter-title">{{ block.settings.heading }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="footer__newsletter-text">{{ block.settings.text }}</div>
          {% endif %}
          
          {% form 'customer', class: 'footer__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer__newsletter-input-wrapper">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="footer__newsletter-input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Newsletter-error--{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="Newsletter-success--{{ section.id }}"
                {% endif %}
                placeholder="Email address"
                required
              >
              <button type="submit" class="footer__newsletter-button" name="commit" aria-label="Subscribe">
                Subscribe
              </button>
            </div>
            {% if form.errors %}
              <small class="footer__newsletter-error" id="Newsletter-error--{{ section.id }}">
                {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
              </small>
            {% endif %}
            {% if form.posted_successfully? %}
              <h3 class="footer__newsletter-success" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>
                Thanks for subscribing!
              </h3>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="footer__payment">
    {% if section.settings.show_payment_icons %}
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag }}
      {% endfor %}
    {% endif %}
  </div>
  
  {%- if abd_theme == 'social' -%}</div>{%- endif -%}
  {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
</footer>

{% stylesheet %}
  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
  }
  footer a {
    text-decoration: none;
    color: var(--color-foreground);
  }
  footer .footer__links,
  footer .footer__payment {
    display: flex;
    gap: 1rem;
  }
{% endstylesheet %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}

{% schema %}
{

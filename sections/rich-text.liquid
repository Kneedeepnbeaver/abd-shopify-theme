{% comment %}
  Rich Text Section
  
  This section displays formatted text content with a heading and rich text
  (formatted content with bold, italic, links, etc.). It's a flexible
  content section that can be used anywhere to add text content. The section
  supports different content widths (narrow, standard, wide, full), text
  alignment options, and typography/color scheme presets.
{% endcomment %}

{% liquid
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
  assign category = section.settings.category
  assign summary = section.settings.summary
%}

<div class="section-rich-text {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-rich-text__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}

    {%- if category != blank -%}
      <div class="abd-category">{{ category }}</div>
      {%- if abd_theme == 'briefing' -%}
        <div class="abd-intel-header">
           <div class="abd-intel-tag">{{ category }} // INTEL</div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="section-rich-text__heading abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if summary != blank -%}
      <div class="abd-summary-box">
        <div class="abd-summary-text">{{ summary }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-rich-text__text abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    <div class="section-rich-text__blocks">
      {% content_for 'blocks' %}
    </div>

    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-rich-text {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}

{% schema %}
{
  "name": "Rich Text",
  "tag": "section",
  "class": "section-rich-text",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Content",
      "default": "<p></p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "left",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Center", "value": "center" },
        { "label": "Right", "value": "right" }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "default": "standard",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "standard", "label": "Standard" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full Width" }
      ]
    },
    {
      "type": "header",
      "content": "ABD Theme Styles"
    },
    {
      "type": "select",
      "id": "abd_theme",
      "label": "ABD Theme Style",
      "default": "",
      "options": [
        { "value": "", "label": "None (Theme Default)" },
        { "value": "cable-news", "label": "Cable News" },
        { "value": "california-dreaming", "label": "California Dreaming" },
        { "value": "california-mission", "label": "California Mission" },
        { "value": "cubism", "label": "Cubism" },
        { "value": "disco", "label": "Disco" },
        { "value": "france", "label": "France" },
        { "value": "free-love", "label": "Free Love" },
        { "value": "highway-street-photo", "label": "Highway Street Photo" },
        { "value": "impressionist", "label": "Impressionist" },
        { "value": "italy", "label": "Italy" },
        { "value": "men's-magazine", "label": "Men'S Magazine" },
        { "value": "military-theme", "label": "Military Theme" },
        { "value": "millennial-myspace", "label": "Millennial Myspace" },
        { "value": "national-parks-poster", "label": "National Parks Poster" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "nineties-graphic-design", "label": "Nineties Graphic Design" },
        { "value": "renaissance", "label": "Renaissance" },
        { "value": "retro-diner", "label": "Retro Diner" },
        { "value": "retro-internet", "label": "Retro Internet" },
        { "value": "retro-tech-polaroid", "label": "Retro Tech Polaroid" },
        { "value": "stars-and-stripes", "label": "Stars And Stripes" },
        { "value": "stpatricks", "label": "Stpatricks" },
        { "value": "synthwave", "label": "Synthwave" },
        { "value": "travel-nyc-liberty", "label": "Travel Nyc Liberty" },
        { "value": "valentines-her", "label": "Valentines Her" },
        { "value": "wayfinding-receipt", "label": "Wayfinding Receipt" },
        { "value": "zine", "label": "Zine" }
      
      
      
      
      
      
      
      
      
      
      
      
      
      ]
    },
    {
      "type": "text",
      "id": "category",
      "label": "Category/Tag",
      "placeholder": "e.g. ANALYSIS or SECRET"
    },
    {
      "type": "textarea",
      "id": "summary",
      "label": "Summary/Intro Text",
      "info": "Display as a summary box or pull quote depending on theme."
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Custom Text Color"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "Custom Accent Color",
      "info": "Used for highlights, borders, and accent elements."
    },
    {
      "type": "color",
      "id": "custom_link",
      "label": "Custom Link Color",
      "info": "Color for links and interactive elements."
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Rich Text",
      "settings": {
        "text_alignment": "left"
      }
    }
  ]
}
{% endschema %}
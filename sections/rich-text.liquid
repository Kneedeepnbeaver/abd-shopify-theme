{% comment %}
  Rich Text Section
  
  This section displays formatted text content with a heading and rich text
  (formatted content with bold, italic, links, etc.). It's a flexible
  content section that can be used anywhere to add text content. The section
  supports different content widths (narrow, standard, wide, full), text
  alignment options, and typography/color scheme presets.
{% endcomment %}

{% liquid
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
  assign category = section.settings.category
  assign summary = section.settings.summary
%}

<div class="section-rich-text {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-rich-text__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}

    {%- if category != blank -%}
      <div class="abd-category">{{ category }}</div>
      {%- if abd_theme == 'briefing' -%}
        <div class="abd-intel-header">
           <div class="abd-intel-tag">{{ category }} // INTEL</div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="section-rich-text__heading abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if summary != blank -%}
      <div class="abd-summary-box">
        <div class="abd-summary-text">{{ summary }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-rich-text__text abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    <div class="section-rich-text__blocks">
      {% content_for 'blocks' %}
    </div>

    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-rich-text {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}


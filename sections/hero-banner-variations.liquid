{% comment %}
  Hero Banner Variations Section
  
  This is a pre-built hero banner section with multiple layout variations
  ready to use. It provides different default configurations (centered, split
  layout, etc.) that merchants can duplicate and customize. This section is
  similar to the main hero-banner section but includes additional layout
  options like split layouts where the image and content are side-by-side.
  
  Variations included:
  - Centered hero with image background
  - Split layout (image left, content right)
  - Full-width image with overlay text
{% endcomment %}

{% liquid
  assign layout_variation = section.settings.layout_variation | default: 'centered'
      assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
  
  assign section_class = 'section-hero-banner section-hero-banner--variations'
  if layout_variation != 'default'
    assign section_class = section_class | append: ' layout-' | append: layout_variation
  endif
      if abd_theme != blank
    assign section_class = section_class | append: ' abd-theme-' | append: abd_theme
  endif
%}

<div class="{{ section_class }} full-width"
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  {% if section.settings.image != blank %}
    <div class="section-hero-banner__image-wrapper">
      {% render 'image', 
        image: section.settings.image, 
        alt: section.settings.heading | default: 'Hero banner',
        class: 'section-hero-banner__image',
        loading: image_loading
      %}
      {% if section.settings.overlay_color != blank %}
        <div class="section-hero-banner__overlay" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
      {% endif %}
    </div>
  {% endif %}
  
  {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
  {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
  
  <div class="section-hero-banner__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-hero-banner__heading abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-hero-banner__text abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif %}

    {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
      <div class="section-hero-banner__button">
        {% render 'button', 
          text: section.settings.button_text, 
          url: section.settings.button_link,
                    size: section.settings.button_size | default: 'large'
        %}
      </div>
    {%- endif %}
  </div>
  
  {%- if abd_theme == 'social' -%}</div>{%- endif -%}
  {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
</div>

{% style %}
  .section-hero-banner--variations {
    position: relative;
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    min-height: {{ section.settings.min_height | default: 400 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .section-hero-banner--variations.layout-split {
    flex-direction: row;
    align-items: stretch;
    min-height: 500px;
  }
  
  .section-hero-banner--variations.layout-split .section-hero-banner__image-wrapper {
    position: relative;
    width: 50%;
    height: auto;
  }
  
  .section-hero-banner--variations.layout-split .section-hero-banner__container {
    width: 50%;
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  @media (max-width: 768px) {
    .section-hero-banner--variations.layout-split {
      flex-direction: column;
    }
    
    .section-hero-banner--variations.layout-split .section-hero-banner__image-wrapper,
    .section-hero-banner--variations.layout-split .section-hero-banner__container {
      width: 100%;
    }
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}

{% schema %}
{

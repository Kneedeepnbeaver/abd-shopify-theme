{% comment %}
  Product Section

  This section displays a single product page with product images, title,
  description, price, variant selection, and add-to-cart functionality. It's
  used in the product template to show all product details to customers.
  The section supports layout variations (default, grid, detailed) and can
  override the theme's color scheme and spacing presets.

  Enhanced with:
  - Image gallery with thumbnails
  - Proper variant selection UI
  - Price component integration
  - Button component integration
  - Better responsive layout
  - Additional product information display
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign layout_variation = section.settings.layout_variation | default: 'default'
  assign show_vendor = section.settings.show_vendor
  assign show_sku = section.settings.show_sku
  assign show_quantity_selector = section.settings.show_quantity_selector
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-product section-product--{{ layout_variation }} {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}"
     data-product-id="{{ product.id }}"
     data-selected-variant-id="{{ current_variant.id }}">
  <div class="section-product__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    <div class="product">
      <div class="product__media">
        {%- if product.images.size > 0 -%}
          <div class="product__main-image">
            {%- for image in product.images -%}
              <div class="product__image-wrapper{% if forloop.first %} product__image-wrapper--active{% endif %}" 
                   data-image-id="{{ image.id }}">
                {% render 'image',
                  image: image,
                  alt: image.alt | default: product.title,
                  class: 'product__image',
                  loading: forloop.first | ternary: 'eager', 'lazy'
                %}
              </div>
            {%- endfor -%}
          </div>

          {%- if product.images.size > 1 -%}
            <div class="product__thumbnails">
              {%- for image in product.images -%}
                <button class="product__thumbnail{% if forloop.first %} product__thumbnail--active{% endif %}"
                        data-image-id="{{ image.id }}"
                        aria-label="View image {{ forloop.index }}">
                  {% render 'image',
                    image: image,
                    alt: image.alt | default: product.title,
                    class: 'product__thumbnail-image',
                    width: 100,
                    height: 100,
                    loading: 'lazy'
                  %}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="product__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
          </div>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if show_vendor and product.vendor != blank -%}
          <p class="product__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product__title abd-title">{{ product.title }}</h1>

        <div class="product__price" data-product-price>
          {% render 'price',
            price: current_variant.price,
            compare_at_price: current_variant.compare_at_price,
            size: 'large'
          %}
        </div>

        {%- if show_sku and current_variant.sku != blank -%}
          <p class="product__sku">
            <span class="product__sku-label">SKU:</span>
            <span class="product__sku-value">{{ current_variant.sku }}</span>
          </p>
        {%- endif -%}

        {%- if product.description != blank -%}
          <div class="product__description abd-content">
            {{ product.description }}
          </div>
        {%- endif -%}

        <div class="product__form" data-product-form>
          {% form 'product', product, class: 'product-form', data-validate: true %}
            <script type="application/json" id="product-data">
              {
                "id": {{ product.id | json }},
                "title": {{ product.title | json }},
                "variants": [
                  {% for variant in product.variants %}
                    {
                      "id": {{ variant.id }},
                      "title": {{ variant.title | json }},
                      "price": {{ variant.price }},
                      "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                      "available": {{ variant.available | json }},
                      "sku": {{ variant.sku | json }},
                      "options": {{ variant.options | json }}{% if variant.featured_image %},
                      "featured_image": {
                        "src": {{ variant.featured_image | image_url: width: 1200 | json }},
                        "alt": {{ variant.featured_image.alt | default: product.title | json }},
                        "id": {{ variant.featured_image.id | json }}
                      }{% endif %}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }
            </script>

            {%- unless product.has_only_default_variant -%}
              <div class="product__variants">
                {%- for option in product.options_with_values -%}
                  <div class="product__variant-option">
                    <label class="product__variant-label" for="option-{{ forloop.index }}">
                      {{ option.name }}:
                    </label>
                    <select class="product__variant-select"
                            id="option-{{ forloop.index }}"
                            name="options[{{ option.name | escape }}]"
                            data-option-index="{{ forloop.index0 }}">
                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}"{% if option.selected_value == value %} selected="selected"{% endif %}>
                          {{ value }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- if show_quantity_selector -%}
              <div class="product__quantity">
                <label class="product__quantity-label" for="quantity">Quantity:</label>
                <input type="number"
                       id="quantity"
                       name="quantity"
                       min="1"
                       value="1"
                       class="product__quantity-input"
                       required>
              </div>
            {%- else -%}
              <input type="hidden" name="quantity" value="1">
            {%- endif -%}

            <div class="product__actions">
              <button type="submit"
                      name="add"
                      class="product__add-to-cart button button--primary button--large"
                      data-add-to-cart
                      {% unless current_variant.available %}disabled{% endunless %}>
                {% if current_variant.available %}
                  Add to cart
                {% else %}
                  Sold out
                {% endif %}
              </button>
              {{ form | payment_button }}
            </div>
          {% endform %}
        </div>

        {%- if section.settings.show_product_meta -%}
          <div class="product__meta">
            {%- if product.type != blank -%}
              <p class="product__meta-item">
                <span class="product__meta-label">Type:</span>
                <span class="product__meta-value">{{ product.type }}</span>
              </p>
            {%- endif -%}
            {%- if product.tags.size > 0 -%}
              <p class="product__meta-item">
                <span class="product__meta-label">Tags:</span>
                <span class="product__meta-value">
                  {%- for tag in product.tags -%}
                    {{ tag }}{% unless forloop.last %}, {% endunless %}
                  {%- endfor -%}
                </span>
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

<script>
  // Make product data available to JavaScript
  if (document.getElementById('product-data')) {
    window.productData = JSON.parse(document.getElementById('product-data').textContent);
  }
</script>

{% style %}
  .section-product {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .product {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .product {
      grid-template-columns: 1fr 1fr;
    }
  }

  .section-product--grid .product {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .section-product--grid .product {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .product__media {
    position: sticky;
    top: 20px;
    height: fit-content;
  }

  .product__main-image {
    position: relative;
    margin-bottom: var(--spacing-md);
  }

  .product__image-wrapper {
    display: none;
  }

  .product__image-wrapper--active {
    display: block;
  }

  .product__image {
    width: 100%;
    height: auto;
    border-radius: var(--style-border-radius-inputs);
  }

  .product__thumbnails {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .product__thumbnail {
    border: 2px solid transparent;
    background: none;
    padding: 0;
    cursor: pointer;
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }

  .product__thumbnail--active {
    border-color: var(--color-primary);
  }

  .product__thumbnail-image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    display: block;
  }

  .product__vendor {
    font-size: 0.875rem;
    color: var(--color-secondary);
    margin-bottom: var(--spacing-xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product__title {
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    margin-bottom: var(--spacing-md);
  }

  .product__sku {
    font-size: 0.875rem;
    color: var(--color-secondary);
    margin-bottom: var(--spacing-md);
  }

  .product__description {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-lg);
  }

  .product__variants {
    margin-bottom: var(--spacing-md);
  }

  .product__variant-option {
    margin-bottom: var(--spacing-sm);
  }

  .product__variant-label {
    display: block;
    font-weight: 500;
    margin-bottom: var(--spacing-xs);
  }

  .product__variant-select {
    width: 100%;
    padding: var(--spacing-sm);
    border: 1px solid var(--color-secondary);
    border-radius: var(--style-border-radius-inputs);
  }

  .product__quantity {
    margin-bottom: var(--spacing-md);
  }

  .product__quantity-label {
    display: block;
    font-weight: 500;
    margin-bottom: var(--spacing-xs);
  }

  .product__quantity-input {
    width: 100px;
    padding: var(--spacing-sm);
    border: 1px solid var(--color-secondary);
    border-radius: var(--style-border-radius-inputs);
  }

  .product__actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .product__meta {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-secondary);
  }

  .product__meta-item {
    font-size: 0.875rem;
    margin-bottom: var(--spacing-xs);
  }

  .product__meta-label {
    font-weight: 500;
    margin-right: var(--spacing-xs);
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}


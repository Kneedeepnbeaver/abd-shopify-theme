{% comment %}
  Cart Section
  
  This section displays the shopping cart with all items, quantities, and prices.
  It supports AJAX updates for quantities and item removal without page reload.
  The cart uses JavaScript for dynamic updates while maintaining form fallback.
  
  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

{% liquid
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-cart {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="{% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-cart__container">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    <h1 class="abd-title">{{ 'cart.title' | t }}</h1>

{% if cart.item_count > 0 %}
  <form action="{{ routes.cart_url }}" method="post" id="cart-form">
    <div class="cart-items">
      {% for item in cart.items %}
        <div class="cart-item" data-cart-item-key="{{ item.key }}">
          <div class="cart-item__image">
            {% render 'image', image: item.image, url: item.url %}
          </div>
          
          <div class="cart-item__details">
            <h3 class="product-title abd-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
             {% if item.variant.title != 'Default Title' %}
              <p class="cart-item__variant">{{ item.variant.title }}</p>
            {% endif %}
            <p class="cart-item__price product-price">{{ item.final_price | money }}</p>
          </div>
          
          <div class="cart-item__quantity">
            <label for="quantity-{{ item.key }}">Quantity:</label>
            <input 
              type="number" 
              id="quantity-{{ item.key }}"
              name="updates[]" 
              value="{{ item.quantity }}"
              min="1"
              data-cart-quantity
              data-cart-key="{{ item.key }}"
            >
          </div>
          
          <div class="cart-item__total">
            <span>{{ item.final_line_price | money }}</span>
          </div>
          
          <div class="cart-item__remove">
            <button 
              type="button" 
              data-cart-remove
              data-cart-key="{{ item.key }}"
              aria-label="Remove {{ item.product.title }}"
            >
              {% render 'icon', icon: 'close', size: 'small' %}
            </button>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="cart-footer">
      <div class="cart-total">
        <strong>Total: {{ cart.total_price | money }}</strong>
      </div>
      
      <div class="cart-actions">
        <button type="submit" name="update" value="Update" class="button button--secondary btn">
          {{ 'cart.update' | t }}
        </button>
        <button type="submit" name="checkout" value="Checkout" class="button button--primary btn">
          {{ 'cart.checkout' | t }}
        </button>
      </div>
    </div>
  </form>
{% else %}
  <div class="cart-empty">
    <p>Your cart is empty.</p>
    <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
      Continue Shopping
    </a>
  </div>
{% endif %}

    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cart-items {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .cart-item {
    display: grid;
    grid-template-columns: 100px 1fr auto auto auto;
    gap: var(--spacing-md);
    align-items: center;
    padding: var(--spacing-md);
    border: 1px solid #ddd;
    border-radius: 8px;
  }

  .cart-item__image {
    width: 100px;
    height: 100px;
    object-fit: cover;
  }

  .cart-item__details h3 {
    margin: 0 0 var(--spacing-xs) 0;
    font-size: var(--font-size-h5);
  }

  .cart-item__details a {
    text-decoration: none;
    color: var(--color-text);
  }

  .cart-item__variant {
    font-size: 14px;
    color: var(--color-secondary);
    margin: 0;
  }

  .cart-item__price {
    margin: var(--spacing-xs) 0 0 0;
    font-weight: 600;
  }

  .cart-item__quantity input {
    width: 60px;
    padding: 8px;
    text-align: center;
  }

  .cart-item__remove button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--color-secondary);
    transition: color var(--animation-duration-fast) var(--animation-easing);
  }

  .cart-item__remove button:hover {
    color: #dc3545;
  }

  .cart-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg);
    border-top: 2px solid #ddd;
    margin-top: var(--spacing-lg);
  }

  .cart-total {
    font-size: var(--font-size-h4);
  }

  .cart-actions {
    display: flex;
    gap: var(--spacing-sm);
  }

  .cart-empty {
    text-align: center;
    padding: var(--spacing-xl);
  }

  @media (max-width: 768px) {
    .cart-item {
      grid-template-columns: 80px 1fr;
      gap: var(--spacing-sm);
    }

    .cart-item__quantity,
    .cart-item__total,
    .cart-item__remove {
      grid-column: 2;
    }

    .cart-footer {
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .cart-actions {
      width: 100%;
    }

    .cart-actions .button {
      flex: 1;
    }
  }
{% endstylesheet %}


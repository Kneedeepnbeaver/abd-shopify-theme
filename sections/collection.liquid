{% comment %}
  Collection Section

  This section displays a collection of products (like a category page).
  It shows the collection title, description, and a grid of products with their
  images, titles, and prices. The section supports different grid layouts (grid,
  list, masonry), responsive columns, and can override the theme's color scheme
  and spacing presets.

  Enhanced with:
  - Product card snippet integration
  - Responsive column controls
  - Better layout options
  - Collection description display
  - Sorting and filtering support
{% endcomment %}

{% liquid
  assign layout_variation = section.settings.layout_variation | default: 'grid'
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign columns_tablet = section.settings.columns_tablet | default: 3
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign products_per_page = section.settings.products_per_page | default: 20
  assign show_vendor = section.settings.show_vendor
  assign show_quick_add = section.settings.show_quick_add
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-collection section-collection--{{ layout_variation }} {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="--columns-mobile: {{ columns_mobile }}; --columns-tablet: {{ columns_tablet }}; --columns-desktop: {{ columns_desktop }}; {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-collection__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    <div class="collection-header">
      <h1 class="collection-header__title abd-title">{{ collection.title }}</h1>
      
      {%- if collection.description != blank -%}
        <div class="collection-header__description">
          {{ collection.description }}
        </div>
      {%- endif -%}

      {%- if collection.products_count > 0 -%}
        <p class="collection-header__count">
          {{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}
        </p>
      {%- endif -%}
    </div>

    <div class="collection-products collection-products--{{ layout_variation }}">
      {% paginate collection.products by products_per_page %}
        {%- if collection.products.size > 0 -%}
          <div class="collection-products__grid">
            {% for product in collection.products %}
              <div class="collection-products__item">
                {% render 'product-card',
                  product: product,
                  show_vendor: show_vendor,
                  show_quick_add: show_quick_add,
                  lazy_load: section.settings.image_loading == 'lazy'
                %}
              </div>
            {% endfor %}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="collection-products__pagination">
              {{ paginate | default_pagination }}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="collection-products__empty">
            <p>{{ 'collections.general.no_products' | t | default: 'No products found in this collection.' }}</p>
          </div>
        {%- endif -%}
      {% endpaginate %}
    </div>
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-collection {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .collection-header {
    margin-bottom: var(--spacing-xl);
    text-align: center;
  }

  .collection-header__title {
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    margin-bottom: var(--spacing-md);
  }

  .collection-header__description {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-sm);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .collection-header__count {
    font-size: 0.875rem;
    color: var(--color-secondary);
  }

  .collection-products__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile), 1fr);
    gap: var(--spacing-md);
  }

  @media (min-width: 768px) {
    .collection-products__grid {
      grid-template-columns: repeat(var(--columns-tablet), 1fr);
    }
  }

  @media (min-width: 1024px) {
    .collection-products__grid {
      grid-template-columns: repeat(var(--columns-desktop), 1fr);
    }
  }

  .collection-products--list .collection-products__grid {
    grid-template-columns: 1fr;
  }

  .collection-products--masonry .collection-products__grid {
    grid-auto-rows: masonry;
  }

  .collection-products__pagination {
    margin-top: var(--spacing-xl);
    text-align: center;
  }

  .collection-products__empty {
    text-align: center;
    padding: var(--spacing-xl);
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}


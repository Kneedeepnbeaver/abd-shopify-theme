{% comment %}
  Image Gallery Section

  A flexible image gallery with responsive columns and consistent aspect ratios.
  Supports unlimited images, lightbox functionality, captions, and various
  aspect ratio options.
{% endcomment %}

{% liquid
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign columns_tablet = section.settings.columns_tablet | default: 3
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign image_spacing = section.settings.image_spacing | default: 16
  assign aspect_ratio = section.settings.aspect_ratio | default: 'square'
  assign abd_theme = section.settings.abd_theme
  assign custom_bg = section.settings.custom_bg
  assign custom_text = section.settings.custom_text
  assign custom_accent = section.settings.custom_accent
  assign custom_link = section.settings.custom_link
%}

<div class="section-image-gallery section-image-gallery--{{ aspect_ratio }} {% if abd_theme != blank %}abd-theme-{{ abd_theme }}{% endif %}"
     style="--columns-mobile: {{ columns_mobile }}; --columns-tablet: {{ columns_tablet }}; --columns-desktop: {{ columns_desktop }}; --image-spacing: {{ image_spacing }}px; {% if custom_bg != blank %}background-color: {{ custom_bg }};{% endif %} {% if custom_text != blank %}color: {{ custom_text }};{% endif %}">
  <div class="section-image-gallery__container page-width">
    {%- if abd_theme contains 'retro' -%}<div class="abd-geocities-box">{%- endif -%}
    {%- if abd_theme == 'social' -%}<div class="abd-myspace-container">{%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="section-image-gallery__heading abd-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="section-image-gallery__text abd-content">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="section-image-gallery__grid">
        {%- for block in section.blocks -%}
          <div class="section-image-gallery__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="image-gallery-item">
                {%- if section.settings.enable_lightbox -%}
                  <a href="{{ block.settings.image | image_url: width: 2000 }}" 
                     class="image-gallery-item__link" 
                     data-lightbox="gallery"
                     data-title="{{ block.settings.caption | default: block.settings.heading | default: 'Image' }}">
                {%- elsif block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="image-gallery-item__link">
                {%- endif -%}
                
                <div class="image-gallery-item__image-wrapper">
                  {% render 'image',
                    image: block.settings.image,
                    alt: block.settings.caption | default: block.settings.heading | default: 'Gallery image',
                    class: 'image-gallery-item__image',
                    loading: section.settings.image_loading | default: 'lazy'
                  %}
                </div>
                
                {%- if section.settings.enable_lightbox or block.settings.link != blank -%}
                  </a>
                {%- endif -%}

                {%- if section.settings.show_captions and block.settings.caption != blank -%}
                  <div class="image-gallery-item__caption">
                    {{ block.settings.caption }}
                  </div>
                {%- elsif section.settings.show_captions and block.settings.heading != blank -%}
                  <div class="image-gallery-item__caption">
                    {{ block.settings.heading }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    
    {%- if abd_theme == 'social' -%}</div>{%- endif -%}
    {%- if abd_theme contains 'retro' -%}</div>{%- endif -%}
  </div>
</div>

{% style %}
  .section-image-gallery {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .section-image-gallery__heading {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    margin-bottom: var(--spacing-md);
  }

  .section-image-gallery__text {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    margin-bottom: var(--spacing-lg);
  }

  .section-image-gallery__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile), 1fr);
    gap: var(--image-spacing);
  }

  @media (min-width: 768px) {
    .section-image-gallery__grid {
      grid-template-columns: repeat(var(--columns-tablet), 1fr);
    }
  }

  @media (min-width: 1024px) {
    .section-image-gallery__grid {
      grid-template-columns: repeat(var(--columns-desktop), 1fr);
    }
  }

  .image-gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--style-border-radius-inputs);
  }

  .image-gallery-item__link {
    display: block;
  }

  .image-gallery-item__image-wrapper {
    position: relative;
    overflow: hidden;
  }

  .section-image-gallery--square .image-gallery-item__image-wrapper {
    aspect-ratio: 1 / 1;
  }

  .section-image-gallery--landscape .image-gallery-item__image-wrapper {
    aspect-ratio: 16 / 9;
  }

  .section-image-gallery--portrait .image-gallery-item__image-wrapper {
    aspect-ratio: 3 / 4;
  }

  .section-image-gallery--auto .image-gallery-item__image-wrapper {
    aspect-ratio: auto;
  }

  .image-gallery-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .image-gallery-item__link:hover .image-gallery-item__image {
    transform: scale(1.05);
  }

  .image-gallery-item__caption {
    padding: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-text);
    text-align: center;
    margin-top: var(--spacing-xs);
  }
{% endstyle %}

{% render 'abd-theme-styles',
  theme: abd_theme,
  custom_bg: custom_bg,
  custom_text: custom_text,
  custom_accent: custom_accent,
  custom_link: custom_link
%}


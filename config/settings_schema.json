          {
            "value": "dark",
            "label": "t:options.color_scheme.dark"
          },
          {
            "value": "vibrant",
            "label": "t:options.color_scheme.vibrant"
          },
          {
            "value": "minimal",
            "label": "t:options.color_scheme.minimal"
          },
          {
            "value": "warm",
            "label": "t:options.color_scheme.warm"

      {
        "type": "color",
        "id": "color_primary",
        "default": "#000000",
        "label": "t:labels.color_primary"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "default": "#666666",
        "label": "t:labels.color_secondary"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#0066CC",
